{
  "$schema": "https://impeccable.style/schema/design-v1.json",
  "version": "1.0.0",
  "name": "Vitrine — Surgical Engineering Brutalism",
  "direction": "Brutalisme Ingénieur (Oxide Computer × Hara Design Institute × Stripe Press)",
  "polarity": {
    "default": "light",
    "supportsInversion": true,
    "storageKey": "vitrine-polarity",
    "attribute": "data-theme"
  },
  "tokens": {
    "color": {
      "light": {
        "bgCanvas": "#FFFFFF",
        "bgSurface": "#F6F6F6",
        "bgElevated": "#EEEEEE",
        "bgInverse": "#0A0A0A",
        "inkPrimary": "#0A0A0A",
        "inkSecondary": "#404040",
        "inkMuted": "#6E6E6E",
        "inkInverse": "#FFFFFF",
        "ruleStrong": "#0A0A0A",
        "ruleHairline": "#E0E0E0"
      },
      "dark": {
        "bgCanvas": "#0A0A0A",
        "bgSurface": "#121212",
        "bgElevated": "#1A1A1A",
        "bgInverse": "#FFFFFF",
        "inkPrimary": "#FFFFFF",
        "inkSecondary": "#B0B0B0",
        "inkMuted": "#808080",
        "inkInverse": "#0A0A0A",
        "ruleStrong": "#FFFFFF",
        "ruleHairline": "#242424"
      }
    },
    "typography": {
      "fontSans": "'Geist Variable', system-ui, -apple-system, sans-serif",
      "fontMono": "'Geist Mono Variable', ui-monospace, SFMono-Regular, monospace",
      "numericVariant": "tabular-nums slashed-zero",
      "scale": {
        "display": "clamp(1.75rem, 2.8vw, 2.5rem)",
        "h2": "clamp(1.25rem, 1.8vw, 1.5rem)",
        "h3": "1rem",
        "body": "0.9375rem",
        "table": "0.875rem",
        "monoMeta": "0.75rem",
        "micro": "0.6875rem"
      },
      "measure": {
        "proseMin": "58ch",
        "proseMax": "68ch",
        "headlineMax": "28ch"
      }
    },
    "layout": {
      "maxWidth": "1200px",
      "columnsDesktop": 12,
      "columnsTablet": 8,
      "columnsMobile": 1,
      "borderRadius": "0px",
      "borderWidth": "1px",
      "minNegativeSpaceRatio": 0.35
    }
  },
  "constraints": {
    "achromaticOnly": true,
    "allowBoxShadow": false,
    "allowGradients": false,
    "allowBorderRadius": false,
    "forbidEmDash": true,
    "cspSelfOnly": true,
    "zeroJsReadable": true
  }
}
