---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ResumeEntry from "../components/ResumeEntry.astro";
import SkillsMatrix from "../components/SkillsMatrix.astro";
import { resumeUrl, t, l, type Lang } from "../i18n";
import { profile } from "../profile";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const experience = await getCollection("experience");
const education = await getCollection("education");
const associations = await getCollection("associations");
const skills = (await getCollection("skills")).sort((a, b) => a.data.order - b.data.order);
const interests = (await getCollection("interests")).sort((a, b) => a.data.order - b.data.order);
const alternates = { fr: resumeUrl("fr"), en: resumeUrl("en") };
---

<Layout
  lang={lang}
  title={`${t(lang, "resume.title")} · ${profile.name}`}
  description={t(lang, "resume.intro")}
  alternates={alternates}
  pole="resume"
>
  <div class="col">
    <section class="intro-block">
      <h1>{profile.name}</h1>
      <p class="intro-sub">{t(lang, "index.role")}</p>
      <p class="seeking-banner">{t(lang, "index.seeking")}</p>

      <div class="inline-actions">
        <a class="text-link" href={profile.cv[lang]}>
          {t(lang, "resume.downloads")} ({lang.toUpperCase()}.PDF)
        </a>
        <button type="button" class="util-link no-print" data-print>{t(lang, "resume.print")}</button>
        <span class="focus-tag">{l(profile.spoken, lang)}</span>
      </div>
    </section>

    <section class="doc-section">
      <div class="section-head">
        <h2>{t(lang, "resume.experience")}</h2>
      </div>
      <div class="cv-list">
        {experience.map((entry) => <ResumeEntry entry={entry.data} lang={lang} />)}
      </div>
    </section>

    <section class="doc-section">
      <div class="section-head">
        <h2>{t(lang, "resume.education")}</h2>
      </div>
      <div class="cv-list">
        {education.map((entry) => <ResumeEntry entry={entry.data} lang={lang} />)}
      </div>
    </section>

    <section class="doc-section">
      <div class="section-head">
        <h2>{t(lang, "resume.skills")}</h2>
      </div>
      <SkillsMatrix groups={skills.map((group) => group.data)} lang={lang} />
    </section>

    <section class="doc-section">
      <div class="section-head">
        <h2>{t(lang, "resume.associations")}</h2>
      </div>
      <div class="cv-list">
        {associations.map((entry) => <ResumeEntry entry={entry.data} lang={lang} />)}
      </div>
    </section>

    <section class="doc-section">
      <div class="section-head">
        <h2>{t(lang, "resume.interests")}</h2>
      </div>
      <dl class="facts">
        {interests.map((entry) => (
          <>
            <dt>{l(entry.data.label, lang)}</dt>
            <dd>{l(entry.data.text, lang)}</dd>
          </>
        ))}
      </dl>
    </section>
  </div>
</Layout>
