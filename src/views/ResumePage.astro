---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ResumeEntry from "../components/ResumeEntry.astro";
import TechWall from "../components/TechWall.astro";
import { resumeUrl, t, l, type Lang } from "../i18n";
import { profile } from "../profile";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const experience = await getCollection("experience");
const education = await getCollection("education");
const associations = await getCollection("associations");
const interests = (await getCollection("interests")).sort((a, b) => a.data.order - b.data.order);
const alternates = { fr: resumeUrl("fr"), en: resumeUrl("en") };
---

<Layout
  lang={lang}
  title={`${t(lang, "resume.title")} | ${profile.name}`}
  description={t(lang, "resume.intro")}
  alternates={alternates}
  pole="resume"
>
  <div class="frame">
    <div class="column-header column-header-top">
      <h1>{t(lang, "resume.title")}</h1>
      <a class="column-header-link no-print" href={profile.cv[lang]}>
        <span>{t(lang, "resume.downloads")} ({lang.toUpperCase()})</span>
        <span aria-hidden="true">↓</span>
      </a>
    </div>

    <div class="reading-column">
      <p>{t(lang, "resume.intro")}</p>
    </div>

    <section class="cv-section">
      <div class="column-header">
        <h2>{t(lang, "resume.experience")}</h2>
      </div>
      <div class="cv-entry-list">
        {experience.map((entry) => <ResumeEntry entry={entry.data} lang={lang} />)}
      </div>
    </section>

    <section class="cv-section">
      <div class="column-header">
        <h2>{t(lang, "resume.education")}</h2>
      </div>
      <div class="cv-entry-list">
        {education.map((entry) => <ResumeEntry entry={entry.data} lang={lang} />)}
      </div>
    </section>

    <section class="cv-section">
      <div class="column-header">
        <h2>{t(lang, "resume.associations")}</h2>
      </div>
      <div class="cv-entry-list">
        {associations.map((entry) => <ResumeEntry entry={entry.data} lang={lang} />)}
      </div>
    </section>

    <TechWall lang={lang} />

    <section class="cv-section">
      <div class="column-header">
        <h2>{t(lang, "resume.spoken")} &amp; {t(lang, "resume.interests")}</h2>
      </div>
      <div class="cv-entry-list">
        <dl class="credit-list">
          <dt>{t(lang, "resume.spoken")}</dt>
          <dd>{l(profile.spoken, lang)}</dd>
          {interests.map((entry) => (
            <>
              <dt>{l(entry.data.label, lang)}</dt>
              <dd>{l(entry.data.text, lang)}</dd>
            </>
          ))}
        </dl>
      </div>
    </section>
  </div>
</Layout>
