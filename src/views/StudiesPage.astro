---
import Layout from "../layouts/Layout.astro";
import { studiesUrl, t, type Lang } from "../i18n";
import { profile } from "../profile";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const alternates = { fr: studiesUrl("fr"), en: studiesUrl("en") };
---

<Layout
  lang={lang}
  title={`${t(lang, "studies.title")} | ${profile.name}`}
  description={t(lang, "studies.p1")}
  alternates={alternates}
  pole="studies"
>
  <div class="frame">
    <div class="content-title">
      <h1>{t(lang, "studies.title")}</h1>
    </div>

    <div class="reading-column">
      <p>{t(lang, "studies.p1")}</p>
      <p>{t(lang, "studies.p2")}</p>
      <p>{t(lang, "studies.p3")}</p>
      <p>{t(lang, "studies.p4")}</p>
    </div>
  </div>
</Layout>
