---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import VmFlow from "../components/VmFlow.astro";
import ResumeEntry from "../components/ResumeEntry.astro";
import SkillsMatrix from "../components/SkillsMatrix.astro";
import { t, l, systemsUrl, type Lang } from "../i18n";
import { profile } from "../profile";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const projects = (await getCollection("projects", (entry) => entry.id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
const experience = await getCollection("experience");
const education = await getCollection("education");
const associations = await getCollection("associations");
const skills = (await getCollection("skills")).sort((a, b) => a.data.order - b.data.order);
const interests = (await getCollection("interests")).sort((a, b) => a.data.order - b.data.order);

const alternates = { fr: "/", en: "/en/" };
---

<Layout
  lang={lang}
  title={`${profile.name} · ${t(lang, "chassis.status")}`}
  description={t(lang, "index.lead")}
  alternates={alternates}
  pole="index"
>
  <div class="col">
    <section class="intro-block">
      <h1>{profile.name}</h1>
      <p class="intro-sub">{t(lang, "index.role")}</p>
      <p class="intro-lead">{t(lang, "index.lead")}</p>

      <p class="seeking-banner">{t(lang, "index.seeking")}</p>

      <div class="inline-actions">
        <a class="text-link" href={profile.cv[lang]}>{t(lang, "index.download")}</a>
        <a class="muted-link" href={`mailto:${profile.email}`}>{t(lang, "index.contact")}</a>
        <a class="muted-link" href={profile.links.github} rel="noopener">{t(lang, "index.source")}</a>
      </div>
    </section>

    <section class="doc-section">
      <div class="section-head">
        <h2>{t(lang, "focus.title")}</h2>
        <span class="focus-tag">{t(lang, "index.served")}</span>
      </div>
      <p class="section-desc">{t(lang, "index.registerIntro")}</p>

      <ul class="focus-list">
        <li class="focus-item">
          <div class="focus-head">
            <h3>
              <a class="text-link" href={systemsUrl(lang, "homelab")}>{t(lang, "focus.vms.title")}</a>
            </h3>
            <span class="focus-tag">homelab-nix · microvm.nix · btrfs</span>
          </div>
          <p class="focus-body">{t(lang, "focus.vms.body")}</p>
        </li>

        <li class="focus-item">
          <div class="focus-head">
            <h3>
              <a class="text-link" href={systemsUrl(lang, "homelab")}>{t(lang, "focus.net.title")}</a>
            </h3>
            <span class="focus-tag">Cilium eBPF · OpenBao · Pocket-ID</span>
          </div>
          <p class="focus-body">{t(lang, "focus.net.body")}</p>
        </li>

        <li class="focus-item">
          <div class="focus-head">
            <h3>
              <a class="text-link" href={systemsUrl(lang, "config")}>{t(lang, "focus.imp.title")}</a>
            </h3>
            <span class="focus-tag">tmpfs · preservation · nix-wrapper-modules</span>
          </div>
          <p class="focus-body">{t(lang, "focus.imp.body")}</p>
        </li>
      </ul>
    </section>
  </div>

  <VmFlow lang={lang} />

  <div class="col">
    <section class="doc-section">
      <div class="section-head">
        <h2>{t(lang, "systems.title")}</h2>
      </div>
      <ul class="project-list">
        {projects.map((project) => {
          const slug = project.id.split("/")[1];
          return (
            <li class="project-row">
              <div class="project-row-head">
                <h3>
                  <a class="text-link" href={systemsUrl(lang, slug)}>{project.data.title}</a>
                </h3>
                {project.data.repo && (
                  <a class="focus-tag muted-link" href={project.data.repo} rel="noopener">
                    {project.data.repo.replace("https://", "")}
                  </a>
                )}
              </div>
              <p class="project-row-summary">{project.data.summary}</p>
              <p class="project-row-meta">
                {project.data.stack.slice(0, 7).join(" · ")} ·{" "}
                <a class="muted-link" href={systemsUrl(lang, slug)}>{t(lang, "index.read")} →</a>
              </p>
            </li>
          );
        })}
      </ul>
    </section>

    <section id="cv" class="doc-section">
      <div class="section-head">
        <h2>{t(lang, "resume.experience")}</h2>
        <a class="focus-tag muted-link no-print" href={profile.cv[lang]}>
          {t(lang, "resume.downloads")} ({lang.toUpperCase()}.PDF)
        </a>
      </div>
      <div class="cv-list">
        {experience.map((entry) => <ResumeEntry entry={entry.data} lang={lang} />)}
      </div>
    </section>

    <section class="doc-section">
      <div class="section-head">
        <h2>{t(lang, "resume.education")}</h2>
        <span class="focus-tag">{l(profile.spoken, lang)}</span>
      </div>
      <div class="cv-list">
        {education.map((entry) => <ResumeEntry entry={entry.data} lang={lang} />)}
      </div>
    </section>

    <section class="doc-section">
      <div class="section-head">
        <h2>{t(lang, "resume.skills")}</h2>
      </div>
      <SkillsMatrix groups={skills.map((group) => group.data)} lang={lang} />
    </section>

    <section class="doc-section">
      <div class="section-head">
        <h2>{t(lang, "resume.associations")}</h2>
      </div>
      <div class="cv-list">
        {associations.map((entry) => <ResumeEntry entry={entry.data} lang={lang} />)}
      </div>
    </section>

    <section class="doc-section">
      <div class="section-head">
        <h2>{t(lang, "resume.interests")}</h2>
      </div>
      <dl class="facts">
        {interests.map((entry) => (
          <>
            <dt>{l(entry.data.label, lang)}</dt>
            <dd>{l(entry.data.text, lang)}</dd>
          </>
        ))}
      </dl>
    </section>
  </div>
</Layout>
