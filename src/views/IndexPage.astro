---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import TechWall from "../components/TechWall.astro";
import { t, systemsUrl, type Lang } from "../i18n";
import { profile } from "../profile";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const projects = (await getCollection("projects", (entry) => entry.id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);

const alternates = { fr: "/", en: "/en/" };
---

<Layout
  lang={lang}
  title={`${profile.name} | ${t(lang, "chassis.status")}`}
  description={t(lang, "index.lead")}
  alternates={alternates}
  pole="index"
>
  <div class="frame">
    <div class="content-title">
      <h1>{t(lang, "index.title")}</h1>
    </div>

    <div class="reading-column">
      <p>{t(lang, "index.p1")}</p>
      <p>{t(lang, "index.p2")}</p>
      <p>{t(lang, "index.p3")}</p>
      <p>{t(lang, "index.p4")}</p>
    </div>

    {projects.map((project) => {
      const slug = project.id.split("/")[1];
      return (
        <section class="top-section">
          <div class="column-header">
            <h2>
              <a href={systemsUrl(lang, slug)}>{project.data.title}</a>
            </h2>
            <a class="column-header-link" href={systemsUrl(lang, slug)}>
              <span>{t(lang, "index.read")}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="reading-column">
            <p>{project.data.summary}</p>
          </div>
        </section>
      );
    })}

    <TechWall lang={lang} />
  </div>
</Layout>
