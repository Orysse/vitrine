---
import { render, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import FactsMatrix from "../components/FactsMatrix.astro";
import VmFlow from "../components/VmFlow.astro";
import Impermanence from "../components/Impermanence.astro";
import { home, systemsUrl, t, type Lang } from "../i18n";
import { profile } from "../profile";

interface Neighbour {
  slug: string;
  title: string;
}
interface Props {
  project: CollectionEntry<"projects">;
  lang: Lang;
  slug: string;
  prev?: Neighbour;
  next?: Neighbour;
}
const { project, lang, slug, prev, next } = Astro.props;
const data = project.data;
const { Content } = await render(project);
const alternates = { fr: systemsUrl("fr", slug), en: systemsUrl("en", slug) };
const activeTab = slug === "homelab" ? "homelab" : slug === "config" ? "config" : "systems";
const otherProject = prev ?? next;
---

<Layout
  lang={lang}
  title={`${data.title.toUpperCase()} | ${profile.name}`}
  description={data.summary}
  alternates={alternates}
  pole={activeTab}
>
  <div class="frame">
    <div class="content-title">
      <h1>{data.title}</h1>
    </div>

    <div class="reading-column">
      <p>{data.summary}</p>
    </div>

    {slug === "homelab" && <VmFlow lang={lang} />}
    {slug === "config" && <Impermanence lang={lang} />}

    <div class="essay-prose">
      <Content />
    </div>

    {data.facts.length > 0 && (
      <div class="entry-credit">
        <h2>{t(lang, "systems.facts")}</h2>
        <FactsMatrix facts={data.facts} />
      </div>
    )}

    <nav class="entry-return no-print" aria-label={t(lang, "systems.title")}>
      <a href={home(lang)}>← {t(lang, "systems.back")}</a>
      {otherProject && (
        <a href={systemsUrl(lang, otherProject.slug)}>
          {otherProject.title.toUpperCase()} →
        </a>
      )}
    </nav>
  </div>
</Layout>
