---
import Layout from "../layouts/Layout.astro";
import { home, t, type Lang } from "../i18n";
import { profile } from "../profile";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Layout
  lang={lang}
  title={`404 | ${profile.name}`}
  description={t(lang, "notfound")}
  alternates={{ fr: "/", en: "/en/" }}
  pole="none"
>
  <div class="frame">
    <div class="content-title">
      <h1>404</h1>
    </div>
    <div class="reading-column">
      <p>{t(lang, "notfound")}</p>
      <p><a href={home(lang)}>← {t(lang, "notfound.hint")}</a></p>
    </div>
  </div>
</Layout>
