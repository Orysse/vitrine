---
import Layout from "../layouts/Layout.astro";
import { home, t, type Lang } from "../i18n";
import { profile } from "../profile";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Layout
  lang={lang}
  title={`404 · ${profile.name}`}
  description={t(lang, "notfound")}
  alternates={{ fr: "/", en: "/en/" }}
  pole="none"
>
  <div class="col">
    <section class="intro-block">
      <h1>404</h1>
      <p class="intro-lead">{t(lang, "notfound")}</p>
      <div class="inline-actions">
        <a class="text-link" href={home(lang)}>{t(lang, "notfound.hint")}</a>
      </div>
    </section>
  </div>
</Layout>
