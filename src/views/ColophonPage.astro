---
import Layout from "../layouts/Layout.astro";
import { colophonUrl, synthUrl, t, type Lang } from "../i18n";
import { profile } from "../profile";
import { build } from "../build";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const alternates = { fr: colophonUrl("fr"), en: colophonUrl("en") };
---

<Layout
  lang={lang}
  title={`${t(lang, "colophon.title")} | ${profile.name}`}
  description={t(lang, "colophon.intro")}
  alternates={alternates}
  pole="none"
>
  <div class="frame">
    <div class="content-title">
      <h1>{t(lang, "colophon.title")}</h1>
    </div>

    <div class="reading-column">
      <p>{t(lang, "colophon.intro")}</p>
    </div>

    <div class="entry-credit">
      <h2>{t(lang, "colophon.build")}</h2>
      <dl class="credit-list">
        <dt>{t(lang, "colophon.version")}</dt>
        <dd>{build.version}</dd>
        <dt>{t(lang, "colophon.revision")}</dt>
        <dd>{build.rev}</dd>
        <dt>{t(lang, "colophon.audio")}</dt>
        <dd><a href={synthUrl(lang)}>VTR-303</a></dd>
      </dl>
    </div>
  </div>
</Layout>
