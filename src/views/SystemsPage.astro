---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import SystemSheet from "../components/SystemSheet.astro";
import VmFlow from "../components/VmFlow.astro";
import { systemsUrl, t, type Lang } from "../i18n";
import { profile } from "../profile";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const projects = (await getCollection("projects", (entry) => entry.id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);

const alternates = { fr: systemsUrl("fr"), en: systemsUrl("en") };
---

<Layout
  lang={lang}
  title={`${t(lang, "systems.title")} · ${profile.name}`}
  description={t(lang, "systems.intro")}
  alternates={alternates}
  pole="systems"
>
  <div class="col">
    <section class="intro-block">
      <h1>{t(lang, "systems.title")}</h1>
      <p class="intro-lead">{t(lang, "systems.intro")}</p>
    </section>
  </div>

  <VmFlow lang={lang} />

  <div class="col">
    {projects.map((project) => (
      <SystemSheet project={project} lang={lang} slug={project.id.split("/")[1]} />
    ))}

    <section class="doc-section">
      <div class="section-head">
        <h2>{t(lang, "systems.notes")}</h2>
      </div>
      <p class="section-desc">{t(lang, "systems.notesSoon")}</p>
    </section>
  </div>
</Layout>
