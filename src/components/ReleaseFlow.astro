---
import { type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const txt = {
  fr: {
    figTitle: "Chaîne de compilation reproductible Nix et déploiement GitOps vers le homelab",
    figMeta: "Orysse/vitrine · flake.nix → ghcr.io → Renovate → Flux",
    caption: "Le build Nix est exécuté dans un bac à sable sans accès réseau. Le conteneur nginx final tourne sous l'UID 65534 avec un système de fichiers en lecture seule.",
    legend1: "Sandbox Nix : zéro accès réseau au build",
    legend2: "Exécution : UID 65534 · rootfs ro · CSP default-src 'none'",

    steps: [
      {
        title: "1. Tag Git semver",
        sub: "git tag vX.Y.Z",
        l1: "Injecte VITRINE_REV et",
        l2: "VITRINE_DATE depuis le commit.",
      },
      {
        title: "2. Build Nix isolé",
        sub: "buildNpmPackage",
        l1: "Dépendances figées via",
        l2: "importNpmLock (sans réseau).",
      },
      {
        title: "3. Image OCI minimale",
        sub: "buildLayeredImage",
        l1: "nginx + fichiers statiques,",
        l2: "sans shell ni gestionnaire.",
      },
      {
        title: "4. Registre & Renovate",
        sub: "ghcr.io/orysse/vitrine",
        l1: "Renovate détecte le tag et",
        l2: "ouvre la PR dans homelab-cluster.",
      },
      {
        title: "5. Réconciliation Flux",
        sub: "apps/vitrine/vitrine.yaml",
        l1: "Déploie les 2 réplicas sur",
        l2: "les microVMs k3s du NUC.",
      },
    ],
    runtimeTitle: "Invariants d'exécution du pod (apps/vitrine) :",
    r1: "Utilisateur : 65534:65534 (nobody), aucun privilège root",
    r2: "Système de fichiers : readOnlyRootFilesystem: true (écriture dans /tmp uniquement)",
    r3: "En-tête CSP : default-src 'none'; script-src 'self' https://pulse.abe.lc; style-src 'self'; font-src 'self'",
  },
  en: {
    figTitle: "Reproducible Nix build pipeline and GitOps delivery to the homelab",
    figMeta: "Orysse/vitrine · flake.nix → ghcr.io → Renovate → Flux",
    caption: "The Nix build runs inside a networkless sandbox. The resulting nginx container runs as UID 65534 with a read-only root filesystem.",
    legend1: "Nix sandbox: zero network access during build",
    legend2: "Runtime: UID 65534 · read-only rootfs · CSP default-src 'none'",

    steps: [
      {
        title: "1. Semver Git tag",
        sub: "git tag vX.Y.Z",
        l1: "Passes VITRINE_REV and",
        l2: "VITRINE_DATE from commit.",
      },
      {
        title: "2. Sandboxed Nix build",
        sub: "buildNpmPackage",
        l1: "Dependencies locked via",
        l2: "importNpmLock (offline).",
      },
      {
        title: "3. Minimal OCI image",
        sub: "buildLayeredImage",
        l1: "nginx + static assets only,",
        l2: "no shell or package manager.",
      },
      {
        title: "4. Registry & Renovate",
        sub: "ghcr.io/orysse/vitrine",
        l1: "Renovate spots the tag and",
        l2: "opens a PR in homelab-cluster.",
      },
      {
        title: "5. Flux reconciliation",
        sub: "apps/vitrine/vitrine.yaml",
        l1: "Rolls out 2 replicas across",
        l2: "the k3s microVMs on the NUC.",
      },
    ],
    runtimeTitle: "Pod runtime invariants (apps/vitrine):",
    r1: "User: 65534:65534 (nobody), zero root privileges",
    r2: "Filesystem: readOnlyRootFilesystem: true (writes restricted to /tmp)",
    r3: "CSP header: default-src 'none'; script-src 'self' https://pulse.abe.lc; style-src 'self'; font-src 'self'",
  },
}[lang];

const xs = [24, 248, 472, 696, 920];
---

<figure class="diagram-bleed">
  <div class="diagram-card">
    <div class="diagram-header">
      <span class="diagram-title">{txt.figTitle}</span>
      <span class="diagram-meta">{txt.figMeta}</span>
    </div>

    <div class="diagram-scroll">
      <svg viewBox="0 0 1160 290" role="img" aria-label={txt.figTitle} preserveAspectRatio="xMidYMid meet">
        <defs>
          <marker id="ar-rel" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path class="d-arrow" d="M 0 1 L 9 5 L 0 9 z" />
          </marker>
        </defs>

        {txt.steps.map((s, i) => (
          <>
            <rect class={i === 1 || i === 4 ? "d-box-fill" : "d-box"} x={xs[i]} y="20" width="204" height="108" />
            <text class="d-title-sm" x={xs[i] + 14} y="44">{s.title}</text>
            <text class="d-label-ink" x={xs[i] + 14} y="62">{s.sub}</text>
            <text class="d-note" x={xs[i] + 14} y="86">{s.l1}</text>
            <text class="d-note" x={xs[i] + 14} y="104">{s.l2}</text>
            {i < xs.length - 1 && (
              <path class="d-line" d={`M ${xs[i] + 204} 74 L ${xs[i + 1] - 4} 74`} marker-end="url(#ar-rel)" />
            )}
          </>
        ))}

        <rect class="d-zone-sub" x="24" y="150" width="1100" height="118" />
        <text class="d-title-sm" x="42" y="176">{txt.runtimeTitle}</text>
        <text class="d-label-ink" x="42" y="200">{txt.r1}</text>
        <text class="d-label-ink" x="42" y="222">{txt.r2}</text>
        <text class="d-label" x="42" y="244">{txt.r3}</text>
      </svg>
    </div>

    <figcaption class="diagram-caption">
      <span>{txt.caption}</span>
      <div class="diagram-legend">
        <span>{txt.legend1}</span>
        <span>·</span>
        <span>{txt.legend2}</span>
      </div>
    </figcaption>
  </div>
</figure>
