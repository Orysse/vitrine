---
import type { Logo } from "../logos";

interface Props {
  logo: Logo;
  /** Tailwind size of the tile, e.g. "size-9". */
  class?: string;
}
const { logo, class: size = "size-9" } = Astro.props;
---

<span class:list={["tile", size]} aria-hidden="true">
  {logo.kind === "svg" && <svg viewBox="0 0 24 24" fill={logo.hex}><path d={logo.path} /></svg>}
  {logo.kind === "img" && <img src={logo.src} alt="" width="128" height="128" decoding="async" />}
  {logo.kind === "none" && <span class="initials">{logo.initials}</span>}
</span>
