---
import type { CollectionEntry } from "astro:content";
import { formatRange } from "../dates";
import { t, type Lang } from "../i18n";
import TopologyFlow from "./TopologyFlow.astro";

interface Props {
  id: string;
  work: CollectionEntry<"works">["data"];
  lang: Lang;
}
const { id, work, lang } = Astro.props;

const dates = work.start ? formatRange(lang, work.start, work.end, t(lang, "work.today")) : "—";

// The impact title with its figure set apart (and in --signal).
const impact = work.impact[lang];
const [before, after] = work.figure ? impact.split(work.figure) : [impact, ""];
---

<details class="work" id={id} name="works">
  <summary>
    <span class="work-n">{String(work.number).padStart(2, "0")}</span>
    <span class="work-head">
      <span class="work-tag">{work.tag[lang]}</span>
      <span class="work-org">{work.org}</span>
      <span class="work-line">{work.line[lang]}</span>
    </span>
    <span class="work-meta">
      <span>{work.status[lang]}</span>
      <span>{dates}</span>
    </span>
  </summary>

  <div class="work-body">
    <div class="work-text">
      <h3 class="work-impact">
        {
          work.figure ? (
            <>
              {before}
              <em class="figure">{work.figure}</em>
              {after}
            </>
          ) : (
            impact
          )
        }
      </h3>
      {work.body.map((p) => <p>{p[lang]}</p>)}
    </div>

    <div class="work-aside">
      {work.logo && <img class="work-logo" src={work.logo.src} alt={work.logo.alt[lang]} width={work.logo.width} height={work.logo.height} />}
      <dl class="materials">
        {
          work.materials.map((m) => (
            <div>
              <dt>{m.key[lang]}</dt>
              <dd>{typeof m.value === "string" ? m.value : m.value[lang]}</dd>
            </div>
          ))
        }
      </dl>
      {
        work.links.length > 0 && (
          <p class="links">
            <span class="links-label">{t(lang, "work.links")}</span>
            {work.links.map((l) => (
              <a href={l.url}>{l.label}</a>
            ))}
          </p>
        )
      }
    </div>

    {
      work.images.length > 0 && (
        <div class="work-images">
          {work.images.map((img) => (
            <img src={img.src} alt={img.alt[lang]} width={img.width} height={img.height} />
          ))}
        </div>
      )
    }

    {id === "homelab" && <TopologyFlow lang={lang} />}
  </div>
</details>
