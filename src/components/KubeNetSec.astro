---
import { type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const txt = {
  fr: {
    figTitle: "Flux réseau Kubernetes (Cilium eBPF default-deny), passerelles et chaîne de secrets",
    figMeta: "homelab-cluster · CiliumNetworkPolicy · OpenBao · Pocket-ID",
    caption: "Tout flux non écrit dans git est bloqué au niveau eBPF. Ce site (vitrine) ne peut initier aucune connexion sortante, pas même une requête DNS.",
    legend1: "Chiffrement inter-nœuds : WireGuard (Cilium)",
    legend2: "Politique par défaut : Egress & Ingress refusés",

    col1Title: "1. Plans d'entrée & Identité OIDC",
    col1Sub: "Séparation stricte public / administration",
    col2Title: "2. Maillage Cilium eBPF (Politiques default-deny par namespace)",
    col2Sub: "Observation temps réel via Hubble · Zéro flux implicite",
    col3Title: "3. Secrets & Base de données",
    col3Sub: "Deux couches : sops (boot) → OpenBao",

    pubInTitle: "Entrée publique (Internet)",
    pubInSub: "HTTPS :443 · Wildcard Let's Encrypt DNS-01",
    traefikPubTitle: "Traefik (Passerelle externe)",
    traefikPubL1: "HSTS, en-têtes de sécurité,",
    traefikPubL2: "routage vers les seuls services publics.",

    vpnInTitle: "Entrée d'administration",
    vpnInSub: "Tunnel VPN WireGuard ou réseau local",
    traefikIntTitle: "Traefik (Passerelle interne)",
    traefikIntL1: "Injoignable depuis Internet.",
    traefikIntL2: "Expose Grafana, Headlamp, OpenBao.",

    oidcTitle: "Pocket-ID (Fournisseur OIDC)",
    oidcPath: "Passkeys WebAuthn uniquement",
    oidcL1: "Aucun compte local dans les outils.",
    oidcL2: "Droits k8s (kubectl/Headlamp) par groupes.",

    nsVitrine: "namespace: vitrine (Isolé)",
    podVitrine: "Pod nginx (2 réplicas · uid 65534)",
    podVitrineL1: "readOnlyRootFilesystem: true · écrit dans /tmp",
    polVitrine: "CiliumNetworkPolicy : Ingress = Traefik public seul",
    polVitrineDeny: "Egress = TOUT REFUSÉ (0 sortie, DNS :53 bloqué)",

    nsApps: "namespace: apps (Services publics avec état)",
    podApps: "Pods Umami (analytics) & Gatus (statut)",
    polApps1: "CiliumNetworkPolicy : Ingress = Traefik public",
    polApps2: "Egress = autorisé vers PostgreSQL (hôte) uniquement",

    nsAdmin: "namespace: infra & monitoring (Interne)",
    podAdmin: "Grafana · Headlamp · Console OpenBao",
    polAdmin1: "Ingress = Traefik interne seul",
    polAdmin2: "Authentification OIDC Pocket-ID obligatoire",

    sopsTitle: "1. sops (Amorçage Git)",
    sopsL1: "Chiffre dans git le strict minimum",
    sopsL2: "pour démarrer (clé d'unseal OpenBao).",

    baoTitle: "2. OpenBao (Coffre-fort central)",
    baoL1: "Configuré par opérateur déclaratif.",
    baoL2: "Politique isolée par namespace k8s.",

    esoTitle: "3. External Secrets Operator",
    esoL1: "Synchronise les secrets OpenBao",
    esoL2: "vers des Secrets Kubernetes chiffrés.",

    pgRotTitle: "4. Rotation PostgreSQL (Hôte)",
    pgRotL1: "OpenBao crée et change les mots de passe",
    pgRotL2: "PostgreSQL : personne ne les connaît.",

    hubbleBar: "Chiffrement transparent : tout le trafic entre les 3 microVMs est chiffré par Cilium via WireGuard. Hubble trace les paquets autorisés et rejetés.",
  },
  en: {
    figTitle: "Kubernetes network flows (Cilium eBPF default-deny), gateways, and secrets chain",
    figMeta: "homelab-cluster · CiliumNetworkPolicy · OpenBao · Pocket-ID",
    caption: "Every flow not explicitly declared in git is dropped at the eBPF layer. This site (vitrine) cannot initiate any outbound connection, not even DNS.",
    legend1: "Node-to-node encryption: WireGuard (Cilium)",
    legend2: "Default policy: all Ingress & Egress denied",

    col1Title: "1. Ingress planes & OIDC Identity",
    col1Sub: "Strict public / admin gateway split",
    col2Title: "2. Cilium eBPF Mesh (Per-namespace default-deny policies)",
    col2Sub: "Real-time flow visibility via Hubble · Zero implicit flows",
    col3Title: "3. Secrets & Database credentials",
    col3Sub: "Two-tier: sops (bootstrap) → OpenBao",

    pubInTitle: "Public ingress (Internet)",
    pubInSub: "HTTPS :443 · Let's Encrypt DNS-01 wildcard",
    traefikPubTitle: "Traefik (External gateway)",
    traefikPubL1: "HSTS, security headers,",
    traefikPubL2: "routes only to public services.",

    vpnInTitle: "Admin ingress",
    vpnInSub: "WireGuard VPN tunnel or local LAN",
    traefikIntTitle: "Traefik (Internal gateway)",
    traefikIntL1: "Unreachable from the public Internet.",
    traefikIntL2: "Exposes Grafana, Headlamp, OpenBao.",

    oidcTitle: "Pocket-ID (OIDC Provider)",
    oidcPath: "WebAuthn passkeys only",
    oidcL1: "Zero local accounts across tools.",
    oidcL2: "Kubernetes RBAC mapped from OIDC groups.",

    nsVitrine: "namespace: vitrine (Air-gapped egress)",
    podVitrine: "nginx pod (2 replicas · uid 65534)",
    podVitrineL1: "readOnlyRootFilesystem: true · /tmp rw only",
    polVitrine: "CiliumNetworkPolicy: Ingress = public Traefik only",
    polVitrineDeny: "Egress = DENY ALL (0 outbound, DNS :53 blocked)",

    nsApps: "namespace: apps (Stateful public apps)",
    podApps: "Umami (analytics) & Gatus (status) pods",
    polApps1: "CiliumNetworkPolicy: Ingress = public Traefik",
    polApps2: "Egress = explicit allow to host PostgreSQL only",

    nsAdmin: "namespace: infra & monitoring (Internal)",
    podAdmin: "Grafana · Headlamp · OpenBao UI",
    polAdmin1: "Ingress = internal Traefik only",
    polAdmin2: "Mandatory Pocket-ID OIDC authentication",

    sopsTitle: "1. sops (Git bootstrap)",
    sopsL1: "Encrypts in git only what is required",
    sopsL2: "to boot (OpenBao unseal key).",

    baoTitle: "2. OpenBao (Central vault)",
    baoL1: "Configured via declarative operator.",
    baoL2: "Templated policy per k8s namespace.",

    esoTitle: "3. External Secrets Operator",
    esoL1: "Syncs OpenBao secrets into",
    esoL2: "encrypted-at-rest k8s Secrets.",

    pgRotTitle: "4. Host PostgreSQL rotation",
    pgRotL1: "OpenBao dynamically creates and rotates",
    pgRotL2: "PostgreSQL passwords: known to no human.",

    hubbleBar: "Transparent encryption: all traffic between the 3 microVMs is encrypted by Cilium over WireGuard. Hubble traces both allowed and dropped packets.",
  },
}[lang];
---

<figure class="diagram-bleed">
  <div class="diagram-card">
    <div class="diagram-header">
      <span class="diagram-title">{txt.figTitle}</span>
      <span class="diagram-meta">{txt.figMeta}</span>
    </div>

    <div class="diagram-scroll">
      <svg viewBox="0 0 1160 610" role="img" aria-label={txt.figTitle} preserveAspectRatio="xMidYMid meet">
        <defs>
          <pattern id="hatch-net" width="8" height="8" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
            <line x1="0" y1="0" x2="0" y2="8" class="d-rule" />
          </pattern>
          <marker id="ar-net" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path class="d-arrow" d="M 0 1 L 9 5 L 0 9 z" />
          </marker>
          <marker id="ar-net-soft" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path class="d-arrow-soft" d="M 0 1 L 9 5 L 0 9 z" />
          </marker>
        </defs>

        <!-- ── COLUMN 1: INGRESS & IDENTITY (x=16, w=284) ── -->
        <rect class="d-zone-sub" x="16" y="20" width="284" height="534" />
        <rect class="d-band" x="16" y="20" width="284" height="48" />
        <line class="d-rule" x1="16" y1="68" x2="300" y2="68" />
        <text class="d-title" x="30" y="42">{txt.col1Title}</text>
        <text class="d-label" x="30" y="58">{txt.col1Sub}</text>

        <!-- Public Ingress + External Traefik -->
        <rect class="d-box" x="32" y="88" width="252" height="132" />
        <text class="d-label-ink" x="46" y="110">{txt.pubInTitle}</text>
        <text class="d-label" x="46" y="126">{txt.pubInSub}</text>
        <line class="d-rule" x1="32" y1="138" x2="284" y2="138" />
        <text class="d-title-sm" x="46" y="160">{txt.traefikPubTitle}</text>
        <text class="d-note" x="46" y="180">{txt.traefikPubL1}</text>
        <text class="d-note" x="46" y="198">{txt.traefikPubL2}</text>

        <!-- Admin VPN Ingress + Internal Traefik -->
        <rect class="d-box" x="32" y="240" width="252" height="132" />
        <text class="d-label-ink" x="46" y="262">{txt.vpnInTitle}</text>
        <text class="d-label" x="46" y="278">{txt.vpnInSub}</text>
        <line class="d-rule" x1="32" y1="290" x2="284" y2="290" />
        <text class="d-title-sm" x="46" y="312">{txt.traefikIntTitle}</text>
        <text class="d-note" x="46" y="332">{txt.traefikIntL1}</text>
        <text class="d-note" x="46" y="350">{txt.traefikIntL2}</text>

        <!-- Pocket-ID OIDC -->
        <rect class="d-box-fill" x="32" y="392" width="252" height="142" />
        <rect class="d-box-inv" x="32" y="392" width="252" height="26" />
        <text class="d-title-inv" x="46" y="409">{txt.oidcTitle}</text>
        <text class="d-label-ink" x="46" y="436">{txt.oidcPath}</text>
        <text class="d-note" x="46" y="460">{txt.oidcL1}</text>
        <text class="d-note" x="46" y="478">{txt.oidcL2}</text>
        <text class="d-label" x="46" y="514">OIDC → Grafana · Headlamp · kubectl</text>

        <!-- ── COLUMN 2: CILIUM EBPF MESH (x=348, w=448) ── -->
        <rect fill="url(#hatch-net)" x="348" y="20" width="448" height="534" />
        <rect class="d-zone" x="348" y="20" width="448" height="534" />
        <rect class="d-band" x="349" y="21" width="446" height="47" />
        <line class="d-rule" x1="348" y1="68" x2="796" y2="68" />
        <text class="d-title" x="364" y="42">{txt.col2Title}</text>
        <text class="d-label" x="364" y="58">{txt.col2Sub}</text>

        <!-- Namespace 1: vitrine -->
        <rect class="d-box" x="368" y="88" width="408" height="136" />
        <rect class="d-band" x="369" y="89" width="406" height="25" />
        <line class="d-rule" x1="368" y1="114" x2="776" y2="114" />
        <text class="d-label-ink" x="382" y="106">{txt.nsVitrine}</text>
        <text class="d-title-sm" x="382" y="136">{txt.podVitrine}</text>
        <text class="d-label" x="382" y="154">{txt.podVitrineL1}</text>
        <rect class="d-box-dash" x="382" y="166" width="380" height="46" />
        <text class="d-label" x="394" y="184">{txt.polVitrine}</text>
        <text class="d-label-ink" x="394" y="202">{txt.polVitrineDeny}</text>

        <!-- Namespace 2: apps -->
        <rect class="d-box" x="368" y="242" width="408" height="132" />
        <rect class="d-band" x="369" y="243" width="406" height="25" />
        <line class="d-rule" x1="368" y1="268" x2="776" y2="268" />
        <text class="d-label-ink" x="382" y="260">{txt.nsApps}</text>
        <text class="d-title-sm" x="382" y="290">{txt.podApps}</text>
        <rect class="d-box-soft" x="382" y="306" width="380" height="54" />
        <text class="d-label" x="394" y="326">{txt.polApps1}</text>
        <text class="d-label-ink" x="394" y="346">{txt.polApps2}</text>

        <!-- Namespace 3: admin & infra -->
        <rect class="d-box" x="368" y="392" width="408" height="142" />
        <rect class="d-band" x="369" y="393" width="406" height="25" />
        <line class="d-rule" x1="368" y1="418" x2="776" y2="418" />
        <text class="d-label-ink" x="382" y="410">{txt.nsAdmin}</text>
        <text class="d-title-sm" x="382" y="440">{txt.podAdmin}</text>
        <rect class="d-box-soft" x="382" y="458" width="380" height="60" />
        <text class="d-label" x="394" y="480">{txt.polAdmin1}</text>
        <text class="d-label-ink" x="394" y="500">{txt.polAdmin2}</text>

        <!-- ── COLUMN 3: SECRETS & DYNAMIC CREDENTIALS (x=844, w=300) ── -->
        <rect class="d-zone-sub" x="844" y="20" width="300" height="534" />
        <rect class="d-band" x="844" y="20" width="300" height="48" />
        <line class="d-rule" x1="844" y1="68" x2="1144" y2="68" />
        <text class="d-title" x="858" y="42">{txt.col3Title}</text>
        <text class="d-label" x="858" y="58">{txt.col3Sub}</text>

        <!-- 1. sops -->
        <rect class="d-box-soft" x="860" y="88" width="268" height="88" />
        <text class="d-title-sm" x="874" y="110">{txt.sopsTitle}</text>
        <text class="d-note" x="874" y="132">{txt.sopsL1}</text>
        <text class="d-note" x="874" y="150">{txt.sopsL2}</text>

        <!-- 2. OpenBao -->
        <rect class="d-box" x="860" y="198" width="268" height="96" />
        <rect class="d-box-inv" x="860" y="198" width="268" height="24" />
        <text class="d-title-inv" x="874" y="214">{txt.baoTitle}</text>
        <text class="d-note" x="874" y="244">{txt.baoL1}</text>
        <text class="d-note" x="874" y="262">{txt.baoL2}</text>

        <!-- 3. External Secrets -->
        <rect class="d-box-soft" x="860" y="316" width="268" height="90" />
        <text class="d-title-sm" x="874" y="338">{txt.esoTitle}</text>
        <text class="d-note" x="874" y="360">{txt.esoL1}</text>
        <text class="d-note" x="874" y="378">{txt.esoL2}</text>

        <!-- 4. PostgreSQL dynamic rotation -->
        <rect class="d-box-fill" x="860" y="428" width="268" height="106" />
        <text class="d-title-sm" x="874" y="450">{txt.pgRotTitle}</text>
        <text class="d-note" x="874" y="472">{txt.pgRotL1}</text>
        <text class="d-note" x="874" y="490">{txt.pgRotL2}</text>
        <text class="d-label-ink" x="874" y="516">TCP :5432 (hôte NixOS)</text>

        <!-- ── FLOW WIRES ── -->
        <!-- External Traefik -> vitrine & apps -->
        <path class="d-line" d="M 284 166 L 324 166 L 324 136 L 364 136" marker-end="url(#ar-net)" />
        <path class="d-line" d="M 324 166 L 324 290 L 364 290" marker-end="url(#ar-net)" />
        <circle class="d-dot" cx="324" cy="166" r="3" />

        <!-- Internal Traefik -> admin & infra -->
        <path class="d-line" d="M 284 316 L 312 316 L 312 440 L 364 440" marker-end="url(#ar-net)" />

        <!-- Pocket-ID -> admin & infra -->
        <path class="d-line-dash" d="M 284 485 L 364 485" marker-end="url(#ar-net-soft)" />

        <!-- sops -> OpenBao -> ESO -> apps -->
        <path class="d-line" d="M 994 176 L 994 194" marker-end="url(#ar-net)" />
        <path class="d-line" d="M 994 294 L 994 312" marker-end="url(#ar-net)" />
        <path class="d-line-dash" d="M 860 360 L 818 360 L 818 290 L 780 290" marker-end="url(#ar-net-soft)" />

        <!-- OpenBao -> PostgreSQL rotation, and apps -> PostgreSQL -->
        <path class="d-line" d="M 1128 248 L 1140 248 L 1140 478 L 1132 478" marker-end="url(#ar-net)" />
        <path class="d-line" d="M 776 340 L 820 340 L 820 480 L 856 480" marker-end="url(#ar-net)" />

        <!-- Bottom Hubble bar -->
        <rect class="d-box-soft" x="16" y="566" width="1128" height="32" />
        <text class="d-label-ink" x="32" y="586">{txt.hubbleBar}</text>
      </svg>
    </div>

    <figcaption class="diagram-caption">
      <span>{txt.caption}</span>
      <div class="diagram-legend">
        <span>{txt.legend1}</span>
        <span>·</span>
        <span>{txt.legend2}</span>
      </div>
    </figcaption>
  </div>
</figure>
