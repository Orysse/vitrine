---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Entry from "./Entry.astro";
import { home, l, projectUrl, t, type Lang } from "../i18n";
import { profile } from "../profile";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Most recent first. Ongoing entries (end: null) sort as "now".
const byDate = <T extends { data: { start: string; end: string | null } }>(a: T, b: T) =>
  (b.data.end ?? "9999").localeCompare(a.data.end ?? "9999") || b.data.start.localeCompare(a.data.start);
const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;

const experience = (await getCollection("experience")).sort(byDate);
const education = (await getCollection("education")).sort(byDate);
const associations = (await getCollection("associations")).sort(byDate);
const skills = (await getCollection("skills")).sort(byOrder);
const interests = (await getCollection("interests")).sort(byOrder).filter((i) => i.id !== "homelab");
const projects = (await getCollection("projects", (p) => p.id.startsWith(`${lang}/`))).sort(byOrder);
const slug = (id: string) => id.split("/")[1];
---

<Layout lang={lang} universe="home" title={`${profile.name} · ${l(profile.major, lang)}`} description={`${l(profile.status, lang)}. ${l(profile.major, lang)}. ${l(profile.looking, lang)}.`} alternates={{ fr: home("fr"), en: home("en") }}>
  <section class="pt-10 sm:pt-16">
    <h1 class="hero-name">{profile.name}</h1>
    <p class="mt-3 mb-0 text-[17px] text-muted">{l(profile.status, lang)}. {l(profile.major, lang)}, {profile.location}.</p>
    <p class="pill mt-7"><span class="pulse" aria-hidden="true"></span>{l(profile.looking, lang)}</p>
    <p class="mt-5 mb-0 text-[17px]">{l(profile.now, lang)}.</p>
    <p class="mt-8 mb-0 flex flex-wrap gap-2.5">
      <a class="btn btn-primary" href={profile.cv[lang]} data-umami-event="cv-download" data-umami-event-lang={lang} data-umami-event-from="hero">{t(lang, lang === "fr" ? "cv.fr" : "cv.en")}</a>
      <a class="btn" href={profile.cv[lang === "fr" ? "en" : "fr"]} data-umami-event="cv-download" data-umami-event-lang={lang === "fr" ? "en" : "fr"} data-umami-event-from="hero">{t(lang, lang === "fr" ? "cv.en" : "cv.fr")}</a>
      <a class="btn print-href" href={profile.links.github} data-print="github.com/Orysse" data-umami-event="github">GitHub</a>
    </p>
  </section>

  <section class="mt-20" id="experience">
    <h2 class="section-title">{t(lang, "section.experience")}</h2>
    <div class="grid gap-1">{experience.map((e) => <Entry entry={e} lang={lang} />)}</div>
  </section>

  <section class="no-print mt-16" id="projects">
    <h2 class="section-title">{t(lang, "section.projects")}</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {projects.map((p) => (
        <a class:list={["project-card", `project-${slug(p.id)}`]} href={projectUrl(lang, slug(p.id))}>
          <img src={p.data.photo.src} alt="" width="1000" height="667" loading="lazy" decoding="async" />
          <span class="project-card-body">
            <span class="font-semibold">{p.data.title} →</span>
            <span class="text-[14.5px] leading-snug text-muted">{p.data.summary}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-16" id="education">
    <h2 class="section-title">{t(lang, "section.education")}</h2>
    <div class="grid gap-1">
      {education.map((e) => <Entry entry={e} lang={lang} />)}
      {associations.map((e) => <Entry entry={e} lang={lang} />)}
    </div>
  </section>

  <section class="mt-16" id="skills">
    <h2 class="section-title">{t(lang, "section.skills")}</h2>
    <dl class="facts">
      {skills.map((s) => (
        <>
          <dt>{l(s.data.label, lang)}</dt>
          <dd>{s.data.items.join(", ")}</dd>
        </>
      ))}
      <dt>{t(lang, "section.spoken")}</dt>
      <dd>{l(profile.spoken, lang)}</dd>
      {interests.map((i) => (
        <>
          <dt>{l(i.data.label, lang)}</dt>
          <dd>{l(i.data.text, lang)}</dd>
        </>
      ))}
    </dl>
  </section>
</Layout>
