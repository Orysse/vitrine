---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Entry from "./Entry.astro";
import { home, l, projectUrl, t, type Lang } from "../i18n";
import { profile } from "../profile";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Most recent first. Ongoing entries (end: null) sort as "now".
const byDate = <T extends { data: { start: string; end: string | null } }>(a: T, b: T) =>
  (b.data.end ?? "9999").localeCompare(a.data.end ?? "9999") || b.data.start.localeCompare(a.data.start);
const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;

const experience = (await getCollection("experience")).sort(byDate);
const education = (await getCollection("education")).sort(byDate);
const associations = (await getCollection("associations")).sort(byDate);
const skills = (await getCollection("skills")).sort(byOrder);
const interests = (await getCollection("interests")).sort(byOrder);
const projects = (await getCollection("projects", (p) => p.id.startsWith(`${lang}/`))).sort(byOrder);
const slug = (id: string) => id.split("/")[1];
const repoName = (url: string) => url.replace("https://github.com/", "");
---

<Layout lang={lang} title={`${profile.name} · ${l(profile.major, lang)}`} description={`${l(profile.status, lang)}. ${l(profile.major, lang)}. ${l(profile.looking, lang)}.`} alternates={{ fr: home("fr"), en: home("en") }}>
  <section>
    <h1 class="display">{profile.name}</h1>
    <p class="mt-5 mb-0 text-muted">{l(profile.status, lang)}. {l(profile.major, lang)}, {profile.location}.</p>
    <p class="mt-6 mb-0">{l(profile.now, lang)}.</p>
    <p class="mt-3 mb-0 font-semibold">{l(profile.looking, lang)}.</p>
    <p class="mt-6 mb-0 flex flex-wrap gap-x-5 gap-y-1">
      <a class="print-href" href={profile.links.github} data-print="github.com/Orysse" data-umami-event="github">GitHub</a>
      <a href={profile.cv.fr} data-umami-event="cv-download" data-umami-event-lang="fr" data-umami-event-from="hero">{t(lang, "cv.fr")}</a>
      <a href={profile.cv.en} data-umami-event="cv-download" data-umami-event-lang="en" data-umami-event-from="hero">{t(lang, "cv.en")}</a>
      <a href={`mailto:${profile.email}`} data-umami-event="email">{profile.email}</a>
      {profile.links.linkedin && <a class="print-href" href={profile.links.linkedin} data-print={profile.links.linkedin.replace("https://www.", "")} data-umami-event="linkedin">LinkedIn</a>}
    </p>
  </section>

  <section class="mt-16" id="experience">
    <h2 class="section-title">{t(lang, "section.experience")}</h2>
    {experience.map((e) => <Entry entry={e} lang={lang} />)}
  </section>

  <section class="mt-16" id="projects">
    <h2 class="section-title">{t(lang, "section.projects")}</h2>
    {projects.map((p) => (
      <a class="row-head" href={projectUrl(lang, slug(p.id))}>
        <span class="font-semibold">{p.data.title}</span>
        {p.data.repo && <span class="meta">{repoName(p.data.repo)}</span>}
        <span class="text-[15px] text-muted sm:col-span-2">{p.data.summary}</span>
      </a>
    ))}
  </section>

  <section class="mt-16" id="education">
    <h2 class="section-title">{t(lang, "section.education")}</h2>
    {education.map((e) => <Entry entry={e} lang={lang} />)}
  </section>

  <section class="mt-16" id="associations">
    <h2 class="section-title">{t(lang, "section.associations")}</h2>
    {associations.map((e) => <Entry entry={e} lang={lang} />)}
  </section>

  <section class="mt-16" id="skills">
    <h2 class="section-title">{t(lang, "section.skills")}</h2>
    <dl class="facts">
      {skills.map((s) => (
        <>
          <dt>{l(s.data.label, lang)}</dt>
          <dd>{s.data.items.join(", ")}</dd>
        </>
      ))}
      <dt>{t(lang, "section.spoken")}</dt>
      <dd>{l(profile.spoken, lang)}</dd>
    </dl>
  </section>

  <section class="mt-16" id="interests">
    <h2 class="section-title">{t(lang, "section.interests")}</h2>
    <dl class="facts">
      {interests.map((i) => (
        <>
          <dt>{l(i.data.label, lang)}</dt>
          <dd class="font-sans! text-[14px]!">{l(i.data.text, lang)}</dd>
        </>
      ))}
    </dl>
  </section>
</Layout>
