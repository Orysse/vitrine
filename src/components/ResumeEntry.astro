---
import { l, period, type Lang, type L10n } from "../i18n";

export interface ResumeEntry {
  org: string;
  orgDetail?: string;
  role: L10n;
  start: string;
  end: string | null;
  location: string;
  stack?: string[];
  points?: L10n[];
}

interface Props {
  entry: ResumeEntry;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const points = entry.points ?? [];
---

<article class="cv-entry">
  <div class="cv-meta">
    <span>{period(entry.start, entry.end, lang)}</span>
    <span>{entry.location}</span>
  </div>

  <h3 class="cv-title">
    {entry.org}
    {entry.orgDetail && <span> ({entry.orgDetail})</span>}
  </h3>

  <p class="cv-role">{l(entry.role, lang)}</p>

  {points.length > 0 && (
    <ul class="cv-points">
      {points.map((point) => (
        <li>{l(point, lang)}</li>
      ))}
    </ul>
  )}
</article>
