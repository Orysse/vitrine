---
import { l, period, type Lang, type L10n } from "../i18n";

export interface ResumeEntry {
  org: string;
  orgDetail?: string;
  role: L10n;
  start: string;
  end: string | null;
  location: string;
  stack?: string[];
  points?: L10n[];
}

interface Props {
  entry: ResumeEntry;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const points = entry.points ?? [];
---

<article class="cv-entry">
  <div class="cv-head">
    <h3 class="cv-org">
      {entry.org}
      {entry.orgDetail && <span class="cv-org-sub"> · {entry.orgDetail}</span>}
    </h3>
    <span class="cv-period">{period(entry.start, entry.end, lang)}</span>
  </div>

  <div class="cv-role-line">
    <span>{l(entry.role, lang)}</span>
    <span class="cv-location">{entry.location}</span>
  </div>

  {entry.stack && entry.stack.length > 0 && (
    <p class="cv-stack">{entry.stack.join(" · ")}</p>
  )}

  {points.length > 0 && (
    <ul class="cv-points">
      {points.map((point) => (
        <li>{l(point, lang)}</li>
      ))}
    </ul>
  )}
</article>
