---
import { type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const txt = {
  fr: {
    z1: "01 · Ce qui est écrit",
    z2: "02 · Ce qui tourne",
    z3: "03 · Ce qui est gardé",
    topology: "topology.nix",
    topologyNote1: "un seul fichier décrit le réseau,",
    topologyNote2: "les hôtes et les nœuds",
    gen: "génère",
    vm: "microVM",
    vmRoot: "racine = tmpfs · pas d'image disque",
    vmKeep: "gardé : identité + données k3s",
    boundary: "Cilium : tout refusé par défaut. Les flux permis sont écrits dans git.",
    state: "l'état s'échappe vers l'hôte",
    host: "hôte NixOS",
    btrfs: "btrfs + btrbk",
    btrfsNote: "volumes NFS, snapshot toutes les heures",
    obs: "VictoriaMetrics / VictoriaLogs",
    obsNote: "métriques, logs, audit de l'API k8s",
    pg: "PostgreSQL",
    pgNote: "mots de passe créés par OpenBao",
    alert: "vmalert + Alertmanager",
    alertNote: "alertes par mail, hors des VMs",
    survive: "Le monitoring tourne sur l'hôte : il survit au cluster.",
    wireguard: "WireGuard : seul accès d'administration.",
    flux: "Flux applique homelab-cluster dans un ordre fixé par dependsOn.",
  },
  en: {
    z1: "01 · What is written",
    z2: "02 · What runs",
    z3: "03 · What is kept",
    topology: "topology.nix",
    topologyNote1: "one file describes the network,",
    topologyNote2: "the hosts and the nodes",
    gen: "generates",
    vm: "microVM",
    vmRoot: "root = tmpfs · no disk image",
    vmKeep: "kept: node identity + k3s data",
    boundary: "Cilium: everything denied by default. Allowed flows are written in git.",
    state: "state escapes to the host",
    host: "NixOS host",
    btrfs: "btrfs + btrbk",
    btrfsNote: "NFS volumes, snapshot every hour",
    obs: "VictoriaMetrics / VictoriaLogs",
    obsNote: "metrics, logs, k8s API audit",
    pg: "PostgreSQL",
    pgNote: "passwords created by OpenBao",
    alert: "vmalert + Alertmanager",
    alertNote: "alerts by mail, outside the VMs",
    survive: "Monitoring runs on the host: it survives the cluster.",
    wireguard: "WireGuard: the only admin access.",
    flux: "Flux applies homelab-cluster in an order fixed by dependsOn.",
  },
}[lang];

const vms = [90, 250, 410];
const vmH = 110;
const hostBoxes = [
  { y: 170, t: txt.btrfs, n: txt.btrfsNote },
  { y: 266, t: txt.obs, n: txt.obsNote },
  { y: 362, t: txt.pg, n: txt.pgNote },
  { y: 458, t: txt.alert, n: txt.alertNote },
];
---

<div class="diagram">
  <svg viewBox="0 0 1280 700" role="img" aria-label={txt.boundary} preserveAspectRatio="xMidYMid meet">
    <!-- zone labels -->
    <text class="d-label" x="40" y="32">{txt.z1}</text>
    <text class="d-label" x="430" y="32">{txt.z2}</text>
    <text class="d-label" x="880" y="32">{txt.z3}</text>

    <!-- 01 written -->
    <rect class="d-box-fill" x="40" y="70" width="250" height="128" />
    <text class="d-title" x="64" y="112">{txt.topology}</text>
    <text class="d-note" x="64" y="142">{txt.topologyNote1}</text>
    <text class="d-note" x="64" y="164">{txt.topologyNote2}</text>

    <!-- generates: fan out to the three VMs -->
    {vms.map((y) => (
      <path class="d-line-soft" d={`M 290 134 L 360 134 L 360 ${y + vmH / 2} L 430 ${y + vmH / 2}`} />
    ))}
    <text class="d-label" x="300" y="122">{txt.gen}</text>

    <!-- 02 computed: three volatile VMs -->
    <rect class="d-box-dash" x="396" y="52" width="380" height="502" />
    {vms.map((y) => (
      <>
        <rect class="d-box" x="430" y={y} width="310" height={vmH} />
        <text class="d-title" x="454" y={y + 36}>{txt.vm}</text>
        <text class="d-label" x="454" y={y + 62}>{txt.vmRoot}</text>
        <text class="d-label" x="454" y={y + 84}>{txt.vmKeep}</text>
      </>
    ))}
    <text class="d-label" x="396" y="582">{txt.boundary}</text>

    <!-- state escapes to the host -->
    {vms.map((y) => (
      <path class="d-line" d={`M 740 ${y + vmH / 2} L 880 ${y + vmH / 2}`} />
    ))}
    <text class="d-label" x="742" y={vms[1] + vmH / 2 - 12}>{txt.state}</text>

    <!-- 03 kept on the host -->
    <rect class="d-box-fill" x="880" y="70" width="360" height="500" />
    <text class="d-title" x="904" y="122">{txt.host}</text>
    {hostBoxes.map((box) => (
      <>
        <rect class="d-box" x="904" y={box.y} width="312" height="78" />
        <text class="d-title d-title-sm" x="924" y={box.y + 32}>{box.t}</text>
        <text class="d-label" x="924" y={box.y + 56}>{box.n}</text>
      </>
    ))}
    <text class="d-note" x="904" y="600">{txt.survive}</text>

    <!-- closing band -->
    <path class="d-line-soft" d="M 40 640 L 1240 640" />
    <text class="d-label d-label-ink" x="40" y="668">{txt.wireguard}</text>
    <text class="d-label" x="640" y="668">{txt.flux}</text>
  </svg>
</div>