---
import { type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const l = {
  fr: {
    aria: "Schéma minimal du homelab : topologie Nix, 3 microVMs sans disque en tmpfs et persistance sur l'hôte",
    caption: "Pointillés : mémoire vive volatile (tmpfs). Trait plein : état conservé sur l'hôte NixOS.",
    git: "topology.nix",
    gitSub: "un attribute set par nœud",
    clusterZone: "CLUSTER K3S ÉPHÉMÈRE · 3 MICROVMS QEMU (RACINE TMPFS, SANS DISQUE)",
    vm1: "vm-k3s-01",
    vm1Sub: "control-plane",
    vm2: "vm-k3s-02",
    vm2Sub: "worker",
    vm3: "vm-k3s-03",
    vm3Sub: "worker",
    mesh: "Cilium eBPF (default-deny · WireGuard) · Flux GitOps · OpenBao · Pocket-ID",
    hostZone: "HÔTE NIXOS · ÉTAT HORS CLUSTER",
    btrfs: "btrfs + btrbk",
    btrfsSub: "état k3s & NFS",
    pg: "PostgreSQL",
    pgSub: "bases applicatives",
    ghost: "vm-k3s-N",
    ghostSub: "une entrée de plus",
  },
  en: {
    aria: "Minimal homelab schematic: Nix topology, 3 diskless tmpfs microVMs, and host-level persistence",
    caption: "Dashed line: volatile RAM (tmpfs). Solid line: state kept on the NixOS host.",
    git: "topology.nix",
    gitSub: "one attribute set per node",
    clusterZone: "EPHEMERAL K3S CLUSTER · 3 DISKLESS QEMU MICROVMS (TMPFS ROOT)",
    vm1: "vm-k3s-01",
    vm1Sub: "control-plane",
    vm2: "vm-k3s-02",
    vm2Sub: "worker",
    vm3: "vm-k3s-03",
    vm3Sub: "worker",
    mesh: "Cilium eBPF (default-deny · WireGuard) · Flux GitOps · OpenBao · Pocket-ID",
    hostZone: "NIXOS HOST · STATE OUTSIDE THE CLUSTER",
    btrfs: "btrfs + btrbk",
    btrfsSub: "k3s state & NFS",
    pg: "PostgreSQL",
    pgSub: "app databases",
    ghost: "vm-k3s-N",
    ghostSub: "one more entry",
  },
}[lang];
---

<figure class="epure-diagram">
  <svg viewBox="0 0 760 360" role="img" aria-label={l.aria}>
    <defs>
      <marker id="arr-hm" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0,1 L7,4 L0,7" fill="none" stroke="#000000" stroke-width="1" />
      </marker>
    </defs>

    <!-- 1. Top source node: topology.nix -->
    <rect x="270" y="8" width="220" height="48" fill="#ffffff" stroke="#000000" stroke-width="1" />
    <text x="380" y="29" text-anchor="middle" font-size="13" font-weight="500" fill="#000000">{l.git}</text>
    <text x="380" y="45" text-anchor="middle" font-size="11" fill="#828282">{l.gitSub}</text>

    <line x1="380" y1="56" x2="380" y2="86" stroke="#000000" stroke-width="1" marker-end="url(#arr-hm)" />

    <!-- 2. Middle ephemeral cluster zone (dashed) -->
    <rect x="20" y="90" width="720" height="122" fill="#ffffff" stroke="#828282" stroke-width="1" stroke-dasharray="4 4" />
    <text x="38" y="110" font-size="10.5" letter-spacing="0.08em" fill="#828282">{l.clusterZone}</text>

    <!-- 3 microVMs -->
    <rect x="38" y="122" width="156" height="50" fill="#ffffff" stroke="#000000" stroke-width="1" stroke-dasharray="3 3" />
    <text x="116" y="144" text-anchor="middle" font-size="13" font-weight="500" fill="#000000">{l.vm1}</text>
    <text x="116" y="160" text-anchor="middle" font-size="11" fill="#828282">{l.vm1Sub} · tmpfs</text>

    <rect x="216" y="122" width="156" height="50" fill="#ffffff" stroke="#000000" stroke-width="1" stroke-dasharray="3 3" />
    <text x="294" y="144" text-anchor="middle" font-size="13" font-weight="500" fill="#000000">{l.vm2}</text>
    <text x="294" y="160" text-anchor="middle" font-size="11" fill="#828282">{l.vm2Sub} · tmpfs</text>

    <rect x="394" y="122" width="156" height="50" fill="#ffffff" stroke="#000000" stroke-width="1" stroke-dasharray="3 3" />
    <text x="472" y="144" text-anchor="middle" font-size="13" font-weight="500" fill="#000000">{l.vm3}</text>
    <text x="472" y="160" text-anchor="middle" font-size="11" fill="#828282">{l.vm3Sub} · tmpfs</text>

    <rect x="572" y="122" width="156" height="50" fill="#ffffff" stroke="#c8c8c8" stroke-width="1" stroke-dasharray="3 3" />
    <text x="650" y="144" text-anchor="middle" font-size="13" font-weight="500" fill="#828282">{l.ghost}</text>
    <text x="650" y="160" text-anchor="middle" font-size="11" fill="#828282">{l.ghostSub}</text>

    <text x="380" y="196" text-anchor="middle" font-size="11.5" fill="#555555">{l.mesh}</text>

    <!-- Connectors from cluster to host -->
    <line x1="116" y1="212" x2="116" y2="244" stroke="#000000" stroke-width="1" marker-end="url(#arr-hm)" />
    <line x1="294" y1="212" x2="294" y2="244" stroke="#000000" stroke-width="1" marker-end="url(#arr-hm)" />
    <line x1="472" y1="212" x2="472" y2="244" stroke="#000000" stroke-width="1" marker-end="url(#arr-hm)" />

    <!-- 3. Bottom physical host zone (solid) -->
    <rect x="20" y="248" width="720" height="100" fill="#ffffff" stroke="#000000" stroke-width="1" />
    <text x="38" y="268" font-size="10.5" letter-spacing="0.08em" fill="#828282">{l.hostZone}</text>

    <rect x="38" y="280" width="340" height="52" fill="#ffffff" stroke="#c8c8c8" stroke-width="1" />
    <text x="208" y="302" text-anchor="middle" font-size="12.5" font-weight="500" fill="#000000">{l.btrfs}</text>
    <text x="208" y="319" text-anchor="middle" font-size="11" fill="#828282">{l.btrfsSub}</text>

    <rect x="398" y="280" width="324" height="52" fill="#ffffff" stroke="#c8c8c8" stroke-width="1" />
    <text x="560" y="302" text-anchor="middle" font-size="12.5" font-weight="500" fill="#000000">{l.pg}</text>
    <text x="560" y="319" text-anchor="middle" font-size="11" fill="#828282">{l.pgSub}</text>

  </svg>
  <figcaption class="epure-caption">{l.caption}</figcaption>
</figure>
