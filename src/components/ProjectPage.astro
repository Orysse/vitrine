---
import { render, type CollectionEntry } from "astro:content";
import Layout, { type Universe } from "../layouts/Layout.astro";
import Arch from "./Arch.astro";
import { projectUrl, t, type Lang } from "../i18n";
import { profile } from "../profile";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Lang;
  slug: string;
}
const { project, lang, slug } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const universe: Universe = slug === "homelab" || slug === "config" ? slug : "home";
---

<Layout lang={lang} universe={universe} wide title={`${p.title} · ${profile.name}`} description={p.summary} alternates={{ fr: projectUrl("fr", slug), en: projectUrl("en", slug) }}>
  <section class="grid items-center gap-8 pt-8 sm:pt-12 md:grid-cols-[minmax(0,1fr)_minmax(0,24rem)]">
    <div>
      <h1 class="page-title">{p.title}</h1>
      <p class="mt-4 mb-0 max-w-[36rem] text-[17px] text-muted">{p.summary}</p>
      {p.repo && <p class="mt-6 mb-0"><a class="btn" href={p.repo}>{t(lang, "project.repo")} · {p.repo.replace("https://github.com/", "")}</a></p>}
    </div>
    <figure class="photo m-0">
      <img src={p.photo.src} alt={p.title} width="1000" height="667" decoding="async" />
      <figcaption><a href={p.photo.url}>{p.photo.credit}, {p.photo.license}</a></figcaption>
    </figure>
  </section>

  <section class="mt-16">
    <h2 class="section-title">{t(lang, "arch.title")}</h2>
    <Arch name={slug} lang={lang} />
  </section>

  <details class="more mt-16 max-w-[44rem]">
    <summary>{t(lang, "project.more")}</summary>
    <div class="prose mt-6">
      <Content />
    </div>
  </details>
</Layout>
