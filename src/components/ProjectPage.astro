---
import { render, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Stack from "./Stack.astro";
import { projectUrl, t, type Lang } from "../i18n";
import { profile } from "../profile";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Lang;
  slug: string;
}
const { project, lang, slug } = Astro.props;
const p = project.data;
const { Content } = await render(project);
---

<Layout lang={lang} title={`${p.title} · ${profile.name}`} description={p.summary} alternates={{ fr: projectUrl("fr", slug), en: projectUrl("en", slug) }}>
  <article>
    <h1 class="m-0 text-[26px] leading-tight font-semibold tracking-[-.01em]">{p.title}</h1>
    <p class="mt-3 mb-0 text-muted">{p.summary}</p>
    {p.repo && <p class="mt-4 mb-0 font-mono text-[13px]"><a href={p.repo}>{p.repo.replace("https://", "")}</a></p>}

    {slug === "homelab" && <div class="mt-14"><Stack lang={lang} /></div>}

    <dl class="facts mt-14">
      {p.facts.map(([k, v]) => (
        <>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </>
      ))}
      <dt>{t(lang, "project.stack")}</dt>
      <dd>{p.stack.join(", ")}</dd>
    </dl>

    <div class="prose mt-6">
      <Content />
    </div>
  </article>
</Layout>
