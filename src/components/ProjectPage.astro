---
import { render, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Stack from "./Stack.astro";
import { projectUrl, t, type Lang } from "../i18n";
import { profile } from "../profile";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Lang;
  slug: string;
}
const { project, lang, slug } = Astro.props;
const p = project.data;
const { Content } = await render(project);
---

<Layout lang={lang} title={`${p.title} · ${profile.name}`} description={p.summary} alternates={{ fr: projectUrl("fr", slug), en: projectUrl("en", slug) }}>
  <article>
    <h1 class="display">{p.title}</h1>
    <p class="mt-5 mb-0 text-muted">{p.summary}</p>
    {p.repo && <p class="mt-4 mb-0 font-mono text-[13px]"><a href={p.repo}>{p.repo.replace("https://", "")}</a></p>}

    {slug === "homelab" && <div class="mt-14"><Stack lang={lang} /></div>}

    <section class="mt-14">
      <h2 class="section-title">{t(lang, "project.highlights")}</h2>
      {p.highlights.map((h) => (
        <div class="entry">
          <h3 class="row-head m-0 text-[16px] font-semibold">{h.title}</h3>
          <p class="mt-0 mb-0 text-[15px] text-muted">{h.text}</p>
        </div>
      ))}
    </section>

    <details class="more mt-14">
      <summary class="section-title cursor-pointer">{t(lang, "project.more")} <span class="toggle" aria-hidden="true">+</span></summary>
      <dl class="facts mt-3">
        {p.facts.map(([k, v]) => (
          <>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </>
        ))}
        <dt>{t(lang, "project.stack")}</dt>
        <dd>{p.stack.join(", ")}</dd>
      </dl>
      <div class="prose mt-6">
        <Content />
      </div>
    </details>
  </article>
</Layout>
