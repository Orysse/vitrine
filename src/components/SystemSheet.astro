---
import type { CollectionEntry } from "astro:content";
import { t, systemsUrl, type Lang } from "../i18n";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Lang;
  slug: string;
}
const { project, lang, slug } = Astro.props;
const data = project.data;
const href = systemsUrl(lang, slug);
---

<section class="top-section">
  <div class="column-header">
    <h2>
      <a href={href}>{data.title}</a>
    </h2>
    <a class="column-header-link" href={href}>
      <span>{t(lang, "index.read")}</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
  <div class="reading-column">
    <p>{data.summary}</p>
  </div>
</section>
