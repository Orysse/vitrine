---
import type { CollectionEntry } from "astro:content";
import { t, systemsUrl, type Lang } from "../i18n";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Lang;
  slug: string;
}
const { project, lang, slug } = Astro.props;
const data = project.data;
const href = systemsUrl(lang, slug);
---

<article class="doc-section">
  <div class="section-head">
    <h2>
      <a class="text-link" href={href}>{data.title}</a>
    </h2>
    {data.repo && (
      <a class="focus-tag muted-link" href={data.repo} rel="noopener">
        {data.repo.replace("https://", "")}
      </a>
    )}
  </div>

  <p class="section-desc">{data.summary}</p>

  <ul class="hl-list">
    {data.highlights.map((highlight) => (
      <li>
        <h3>{highlight.title}</h3>
        <p>{highlight.text}</p>
      </li>
    ))}
  </ul>

  <div class="inline-actions">
    <a class="text-link" href={href}>{t(lang, "index.read")} →</a>
    <span class="focus-tag">{data.stack.slice(0, 8).join(" · ")}</span>
  </div>
</article>
