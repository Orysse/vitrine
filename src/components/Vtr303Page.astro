---
import Layout from "../layouts/Layout.astro";
import Vtr303 from "./Vtr303.astro";
import { synthUrl, t, type Lang } from "../i18n";
import { profile } from "../profile";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const help = {
  fr: [
    ["Potards", "glisser verticalement, molette ou flèches ; Maj pour un réglage fin ; double-clic = valeur par défaut"],
    ["Pas", "cliquer un pas pour le sélectionner, puis une note du clavier. DOWN et UP changent l'octave, ACCENT accentue, SLIDE lie au pas suivant, REST met un silence. Les LED montrent l'état du pas sélectionné."],
    ["Clavier", "a w s e d f t g y h u j k = notes sur le pas sélectionné, puis passe au suivant ; ← → change de pas ; - ou 0 = silence ; espace = lecture"],
  ],
  en: [
    ["Knobs", "drag vertically, scroll or use the arrow keys; Shift for fine control; double-click = default value"],
    ["Steps", "click a step to select it, then a note on the keyboard. DOWN and UP change the octave, ACCENT accents, SLIDE ties into the next step, REST makes a rest. The LEDs show the selected step."],
    ["Keyboard", "a w s e d f t g y h u j k = notes on the selected step, then moves to the next; ← → change step; - or 0 = rest; space = play"],
  ],
}[lang];
---

<Layout lang={lang} title={`VTR-303 · ${profile.name}`} description={t(lang, "vtr.lead")} alternates={{ fr: synthUrl("fr"), en: synthUrl("en") }} universe="synth" wide>
  <h1 class="page-title pt-8 sm:pt-12">VTR-303</h1>
  <p class="mt-3 mb-0 max-w-[38rem] text-muted">{t(lang, "vtr.lead")}</p>

  <div class="mt-10">
    <noscript><p class="m-0">{t(lang, "vtr.nojs")}</p></noscript>
    <Vtr303 lang={lang} />
  </div>

  <dl class="facts mt-10 max-w-[42rem]">
    {help.map(([k, v]) => (
      <>
        <dt>{k}</dt>
        <dd class="font-sans! text-[14px]!">{v}</dd>
      </>
    ))}
  </dl>

  <script>
    import { vtr303 } from "../scripts/vtr303";
    const root = document.querySelector<HTMLElement>("[data-vtr]");
    if (root) vtr303(root);
  </script>
</Layout>
