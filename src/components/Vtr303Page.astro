---
import Layout from "../layouts/Layout.astro";
import Vtr303 from "./Vtr303.astro";
import { synthUrl, t, type Lang } from "../i18n";
import { profile } from "../profile";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const help = {
  fr: [
    ["Potards", "glisser verticalement, molette ou flèches ; Maj pour un réglage fin ; double-clic = valeur par défaut"],
    ["Pas", "cliquer un pas pour le sélectionner, puis une note du clavier. DOWN et UP changent l'octave, ACCENT accentue, SLIDE lie au pas suivant, REST met un silence."],
    ["Clavier", "a w s e d f t g y h u j k = notes sur le pas sélectionné ; ← → change de pas ; - ou 0 = silence ; espace = lecture"],
  ],
  en: [
    ["Knobs", "drag vertically, scroll or use the arrow keys; Shift for fine control; double-click = default value"],
    ["Steps", "click a step to select it, then a note on the keyboard. DOWN and UP change the octave, ACCENT accents, SLIDE ties into the next step, REST makes a rest."],
    ["Keyboard", "a w s e d f t g y h u j k = notes on the selected step; ← → change step; - or 0 = rest; space = play"],
  ],
}[lang];
---

<Layout
  lang={lang}
  title={`VTR-303 · ${profile.name}`}
  description={t(lang, "vtr.lead")}
  alternates={{ fr: synthUrl("fr"), en: synthUrl("en") }}
  pole="none"
>
  <section class="g12 hero">
    <p class="label c1-3">EXTRA</p>
    <h1 class="c1-8 display">VTR-303</h1>
    <p class="c1-7 lede">{t(lang, "vtr.lead")}</p>
  </section>

  <section class="g12 section-tight">
    <div class="c1-12">
      <noscript><p class="body-lg">{t(lang, "vtr.nojs")}</p></noscript>
      <Vtr303 lang={lang} />
    </div>
  </section>

  <section class="g12 section-tight">
    <p class="label c1-2">AIDE</p>
    <div class="c2-12">
      <dl class="facts">
        {help.map(([k, v]) => (
          <>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </>
        ))}
      </dl>
    </div>
  </section>
</Layout>

<script>
  import { vtr303 } from "../scripts/vtr303";
  const root = document.querySelector<HTMLElement>("[data-vtr]");
  if (root) vtr303(root);
</script>