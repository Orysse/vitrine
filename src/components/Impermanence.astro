---
import { type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const l = {
  fr: {
    aria: "Schéma minimal du poste NixOS : démarrage Secure Boot TPM2, racine tmpfs éphémère et paquets nix-wrapper-modules",
    caption: "Pointillés : détruit à chaque extinction (tmpfs). Trait plein : conservé sur le volume chiffré LUKS.",
    bootZone: "CHAÎNE DE DÉMARRAGE MATÉRIEL",
    b1: "Lanzaboote",
    b1Sub: "UEFI Secure Boot",
    b2: "TPM2 + LUKS",
    b2Sub: "partitionnement disko",
    b3: "sops-nix",
    b3Sub: "secrets YubiKey",
    fsZone: "SYSTÈME DE FICHIERS AU DÉMARRAGE",
    tmpfs: "Racine / en tmpfs (RAM)",
    tmpfsSub: "effacée à chaque extinction",
    persist: "/nix/store & /persistent",
    persistSub: "seuls chemins conservés (preservation)",
    wrapZone: "APPLICATIONS AUTO-PORTÉES (NIX-WRAPPER-MODULES)",
    wrapTitle: "nix-wrapper-modules",
    wrapSub: "chaque binaire embarque sa configuration dans /nix/store (nix run .#nvim)",
    apps: "neovim · kitty · tmux · river · waybar · zsh",
  },
  en: {
    aria: "Minimal NixOS workstation schematic: TPM2 Secure Boot, ephemeral tmpfs root, and nix-wrapper-modules packages",
    caption: "Dashed line: wiped on every shutdown (tmpfs). Solid line: kept on the LUKS-encrypted volume.",
    bootZone: "HARDWARE BOOT CHAIN",
    b1: "Lanzaboote",
    b1Sub: "UEFI Secure Boot",
    b2: "TPM2 + LUKS",
    b2Sub: "disko layout",
    b3: "sops-nix",
    b3Sub: "YubiKey secrets",
    fsZone: "FILESYSTEM SPLIT AT BOOT",
    tmpfs: "Root / on tmpfs (RAM)",
    tmpfsSub: "wiped on every shutdown",
    persist: "/nix/store & /persistent",
    persistSub: "only paths kept on disk (preservation)",
    wrapZone: "SELF-CONTAINED PACKAGES (NIX-WRAPPER-MODULES)",
    wrapTitle: "nix-wrapper-modules",
    wrapSub: "each binary bundles its own configuration in /nix/store (nix run .#nvim)",
    apps: "neovim · kitty · tmux · river · waybar · zsh",
  },
}[lang];
---

<figure class="epure-diagram">
  <svg viewBox="0 0 760 330" role="img" aria-label={l.aria}>
    <defs>
      <marker id="arr-imp" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0,1 L7,4 L0,7" fill="none" stroke="#000000" stroke-width="1" />
      </marker>
    </defs>

    <!-- 1. Boot chain row -->
    <text x="20" y="20" font-size="10.5" letter-spacing="0.08em" fill="#828282">{l.bootZone}</text>

    <rect x="20" y="32" width="216" height="50" fill="#ffffff" stroke="#000000" stroke-width="1" />
    <text x="128" y="54" text-anchor="middle" font-size="13" font-weight="500" fill="#000000">{l.b1}</text>
    <text x="128" y="70" text-anchor="middle" font-size="11" fill="#828282">{l.b1Sub}</text>

    <line x1="236" y1="57" x2="270" y2="57" stroke="#000000" stroke-width="1" marker-end="url(#arr-imp)" />

    <rect x="272" y="32" width="216" height="50" fill="#ffffff" stroke="#000000" stroke-width="1" />
    <text x="380" y="54" text-anchor="middle" font-size="13" font-weight="500" fill="#000000">{l.b2}</text>
    <text x="380" y="70" text-anchor="middle" font-size="11" fill="#828282">{l.b2Sub}</text>

    <line x1="488" y1="57" x2="522" y2="57" stroke="#000000" stroke-width="1" marker-end="url(#arr-imp)" />

    <rect x="524" y="32" width="216" height="50" fill="#ffffff" stroke="#000000" stroke-width="1" />
    <text x="632" y="54" text-anchor="middle" font-size="13" font-weight="500" fill="#000000">{l.b3}</text>
    <text x="632" y="70" text-anchor="middle" font-size="11" fill="#828282">{l.b3Sub}</text>

    <!-- Connectors down to filesystem split -->
    <line x1="210" y1="82" x2="210" y2="128" stroke="#000000" stroke-width="1" marker-end="url(#arr-imp)" />
    <line x1="550" y1="82" x2="550" y2="128" stroke="#000000" stroke-width="1" marker-end="url(#arr-imp)" />

    <!-- 2. Filesystem split -->
    <text x="20" y="120" font-size="10.5" letter-spacing="0.08em" fill="#828282">{l.fsZone}</text>

    <!-- Left: Volatile tmpfs root -->
    <rect x="20" y="132" width="340" height="64" fill="#ffffff" stroke="#828282" stroke-width="1" stroke-dasharray="4 4" />
    <text x="190" y="160" text-anchor="middle" font-size="13" font-weight="500" fill="#000000">{l.tmpfs}</text>
    <text x="190" y="178" text-anchor="middle" font-size="11" fill="#828282">{l.tmpfsSub}</text>

    <!-- Right: Persistent btrfs subvolumes -->
    <rect x="400" y="132" width="340" height="64" fill="#ffffff" stroke="#000000" stroke-width="1" />
    <text x="570" y="160" text-anchor="middle" font-size="13" font-weight="500" fill="#000000">{l.persist}</text>
    <text x="570" y="178" text-anchor="middle" font-size="11" fill="#828282">{l.persistSub}</text>

    <!-- Connector from /nix/store to wrapper-modules -->
    <line x1="570" y1="196" x2="570" y2="230" stroke="#000000" stroke-width="1" marker-end="url(#arr-imp)" />

    <!-- 3. Wrapper modules -->
    <rect x="20" y="234" width="720" height="82" fill="#ffffff" stroke="#000000" stroke-width="1" />
    <text x="38" y="254" font-size="10.5" letter-spacing="0.08em" fill="#828282">{l.wrapZone}</text>
    <text x="380" y="279" text-anchor="middle" font-size="13" font-weight="500" fill="#000000">{l.wrapTitle} · {l.apps}</text>
    <text x="380" y="298" text-anchor="middle" font-size="11" fill="#828282">{l.wrapSub}</text>
  </svg>
  <figcaption class="epure-caption">{l.caption}</figcaption>
</figure>
