---
import { type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const l = {
  fr: {
    aria: "Schéma de la config NixOS : trois couches assemblées par un hôte, racine tmpfs effacée à chaque extinction, programmes emballés lancés sur une autre machine",
    caption: "Pointillés : détruit à chaque extinction (tmpfs). Trait plein : conservé.",
    layersZone: "UN DÉPÔT, TROIS COUCHES ASSEMBLÉES",
    f1: "features",
    f1Sub: "programmes emballés",
    f2: "system",
    f2Sub: "démarrage, réseau, audio",
    f3: "flavors",
    f3Sub: "profils selon le rôle",
    host: "hosts",
    hostSub: "un hôte de plus = un assemblage de plus",
    fsZone: "SUR LA MACHINE",
    tmpfs: "Racine / en tmpfs (RAM)",
    tmpfsSub: "effacée à chaque extinction",
    persist: "/nix/store & /persistent",
    persistSub: "seuls chemins conservés (preservation)",
    otherZone: "SUR UNE AUTRE MACHINE AVEC NIX",
    run: "nix run github:Orysse/config#nvim",
    runSub: "le programme emballé se lance avec sa configuration, sans rien écrire dans le dossier personnel",
  },
  en: {
    aria: "NixOS config schematic: three layers assembled by a host, tmpfs root wiped on every shutdown, wrapped programs run on another machine",
    caption: "Dashed line: wiped on every shutdown (tmpfs). Solid line: kept.",
    layersZone: "ONE REPOSITORY, THREE ASSEMBLED LAYERS",
    f1: "features",
    f1Sub: "wrapped programs",
    f2: "system",
    f2Sub: "boot, network, audio",
    f3: "flavors",
    f3Sub: "profiles by role",
    host: "hosts",
    hostSub: "one more host = one more assembly",
    fsZone: "ON THE MACHINE",
    tmpfs: "Root / on tmpfs (RAM)",
    tmpfsSub: "wiped on every shutdown",
    persist: "/nix/store & /persistent",
    persistSub: "only paths kept on disk (preservation)",
    otherZone: "ON ANOTHER MACHINE WITH NIX",
    run: "nix run github:Orysse/config#nvim",
    runSub: "the wrapped program starts with its configuration, writing nothing to the home directory",
  },
}[lang];
---

<figure class="epure-diagram">
  <svg viewBox="0 0 760 420" role="img" aria-label={l.aria}>
    <defs>
      <marker id="arr-imp" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0,1 L7,4 L0,7" fill="none" stroke="#000000" stroke-width="1" />
      </marker>
    </defs>

    <!-- 1. Layers -->
    <text x="20" y="20" font-size="10.5" letter-spacing="0.08em" fill="#828282">{l.layersZone}</text>

    <rect x="20" y="32" width="216" height="50" fill="#ffffff" stroke="#000000" stroke-width="1" />
    <text x="128" y="54" text-anchor="middle" font-size="13" font-weight="500" fill="#000000">{l.f1}</text>
    <text x="128" y="70" text-anchor="middle" font-size="11" fill="#828282">{l.f1Sub}</text>

    <rect x="272" y="32" width="216" height="50" fill="#ffffff" stroke="#000000" stroke-width="1" />
    <text x="380" y="54" text-anchor="middle" font-size="13" font-weight="500" fill="#000000">{l.f2}</text>
    <text x="380" y="70" text-anchor="middle" font-size="11" fill="#828282">{l.f2Sub}</text>

    <rect x="524" y="32" width="216" height="50" fill="#ffffff" stroke="#000000" stroke-width="1" />
    <text x="632" y="54" text-anchor="middle" font-size="13" font-weight="500" fill="#000000">{l.f3}</text>
    <text x="632" y="70" text-anchor="middle" font-size="11" fill="#828282">{l.f3Sub}</text>

    <line x1="128" y1="82" x2="128" y2="118" stroke="#000000" stroke-width="1" marker-end="url(#arr-imp)" />
    <line x1="380" y1="82" x2="380" y2="118" stroke="#000000" stroke-width="1" marker-end="url(#arr-imp)" />
    <line x1="632" y1="82" x2="632" y2="118" stroke="#000000" stroke-width="1" marker-end="url(#arr-imp)" />

    <rect x="20" y="120" width="720" height="50" fill="#ffffff" stroke="#000000" stroke-width="1" />
    <text x="380" y="142" text-anchor="middle" font-size="13" font-weight="500" fill="#000000">{l.host}</text>
    <text x="380" y="158" text-anchor="middle" font-size="11" fill="#828282">{l.hostSub}</text>

    <!-- 2. On the machine -->
    <text x="20" y="204" font-size="10.5" letter-spacing="0.08em" fill="#828282">{l.fsZone}</text>

    <line x1="190" y1="170" x2="190" y2="220" stroke="#000000" stroke-width="1" marker-end="url(#arr-imp)" />
    <line x1="570" y1="170" x2="570" y2="220" stroke="#000000" stroke-width="1" marker-end="url(#arr-imp)" />

    <rect x="20" y="222" width="340" height="64" fill="#ffffff" stroke="#828282" stroke-width="1" stroke-dasharray="4 4" />
    <text x="190" y="250" text-anchor="middle" font-size="13" font-weight="500" fill="#000000">{l.tmpfs}</text>
    <text x="190" y="268" text-anchor="middle" font-size="11" fill="#828282">{l.tmpfsSub}</text>

    <rect x="400" y="222" width="340" height="64" fill="#ffffff" stroke="#000000" stroke-width="1" />
    <text x="570" y="250" text-anchor="middle" font-size="13" font-weight="500" fill="#000000">{l.persist}</text>
    <text x="570" y="268" text-anchor="middle" font-size="11" fill="#828282">{l.persistSub}</text>

    <!-- 3. Another machine -->
    <text x="20" y="324" font-size="10.5" letter-spacing="0.08em" fill="#828282">{l.otherZone}</text>

    <rect x="20" y="336" width="720" height="64" fill="#ffffff" stroke="#000000" stroke-width="1" />
    <text x="380" y="364" text-anchor="middle" font-size="13" font-weight="500" fill="#000000">{l.run}</text>
    <text x="380" y="382" text-anchor="middle" font-size="11" fill="#828282">{l.runSub}</text>
  </svg>
  <figcaption class="epure-caption">{l.caption}</figcaption>
</figure>
