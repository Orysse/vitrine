---
import Layout from "../layouts/Layout.astro";
import Ground from "./Ground.astro";
import { home, homelabUrl, l, t, type Lang, type UiKey } from "../i18n";
import { profile } from "../profile";
import { BLOCK_H, BLOCK_W, VIEW, blocks, frames, layers, links, paths, principles, type Block, type Zone } from "../data/homelab";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const byId = new Map(blocks.map((b) => [b.id, b]));
const get = (id: string): Block => {
  const b = byId.get(id);
  if (!b) throw new Error(`homelab: unknown block "${id}"`);
  return b;
};
const box = (b: Block) => ({ x: b.x, y: b.y, w: b.w ?? BLOCK_W, h: BLOCK_H });

// Point where the line from a block's centre towards (tx, ty) leaves the block.
function edge(b: Block, tx: number, ty: number): [number, number] {
  const r = box(b);
  const cx = r.x + r.w / 2;
  const cy = r.y + r.h / 2;
  const dx = tx - cx;
  const dy = ty - cy;
  const k = Math.min(dx ? r.w / 2 / Math.abs(dx) : Infinity, dy ? r.h / 2 / Math.abs(dy) : Infinity);
  return [cx + dx * k, cy + dy * k];
}
function segment(from: string, to: string): string {
  const a = get(from);
  const b = get(to);
  const ra = box(a);
  const rb = box(b);
  const [x1, y1] = edge(a, rb.x + rb.w / 2, rb.y + rb.h / 2);
  const [x2, y2] = edge(b, ra.x + ra.w / 2, ra.y + ra.h / 2);
  return `M${x1.toFixed(1)} ${y1.toFixed(1)} L${x2.toFixed(1)} ${y2.toFixed(1)}`;
}

const zones: Zone[] = ["external", "host", "cluster", "platform", "app"];
const zoneOf = (z: Zone) => t(lang, `hl.zone.${z}` as UiKey);
---

<Layout lang={lang} title={`Homelab · ${profile.name}`} description={t(lang, "hl.lead")} alternates={{ fr: homelabUrl("fr"), en: homelabUrl("en") }}>
  <Ground kind="riley">
    <p class="label m-0"><a class="inline-block bg-ink px-2.5 py-1 text-yellow no-underline hover:bg-yellow hover:text-ink" href={`${home(lang)}#projects`}>← {t(lang, "project.back")}</a></p>
    <h1 class="title mt-6 text-ink [text-shadow:4px_4px_0_var(--color-paper)]">{t(lang, "hl.title")}</h1>
    <div class="mt-6 flex flex-wrap items-end gap-5">
      <p class="box m-0 max-w-[720px] font-serif text-[22px] leading-snug italic">{t(lang, "hl.lead")}</p>
      <p class="label m-0 flex flex-wrap gap-2">
        <a class="inline-block bg-paper px-3 py-2 no-underline shadow-print-sm hover:bg-yellow" href={profile.links.homelabNix}>homelab-nix ↗</a>
        <a class="inline-block bg-paper px-3 py-2 no-underline shadow-print-sm hover:bg-yellow" href={profile.links.homelabCluster}>homelab-cluster ↗</a>
      </p>
    </div>
  </Ground>

  <Ground kind="waves" id="map" label={t(lang, "hl.map")}>
    <div class="hl grid items-start gap-5 2xl:grid-cols-[minmax(0,1fr)_340px]" data-homelab>
      <div class="box flex flex-wrap items-center gap-2 py-3" data-js-only hidden>
        <span class="label mr-1">{t(lang, "hl.paths")}</span>
        {paths.map((p) => <button type="button" class="hl-btn" aria-pressed="false" data-path-btn={p.id}>{l(p.title, lang)}</button>)}
        <button type="button" class="hl-btn" data-clear>{t(lang, "hl.clear")}</button>
      </div>
      <aside class="box box-ink grid min-h-[190px] content-start gap-3 2xl:sticky 2xl:top-20 2xl:col-start-2 2xl:row-span-2 2xl:row-start-1" aria-live="polite" data-panel>
        <div data-panel-default>
          <p class="label m-0 text-pink">{t(lang, "hl.map")}</p>
          <p class="m-0 mt-2 text-paper">{t(lang, "hl.hint")}</p>
          <ul class="mt-4 grid list-none gap-1.5 p-0 text-[13px] text-paper">
            {zones.map((z) => <li class="flex items-center gap-2"><span class={`hl-swatch zone-${z}`}></span>{zoneOf(z)}</li>)}
          </ul>
        </div>
        <div data-panel-block hidden>
          <p class="label m-0 text-pink" data-panel-zone></p>
          <h2 class="m-0 mt-1 font-display text-[28px] leading-none text-yellow" data-panel-title></h2>
          <p class="m-0 mt-3 text-paper" data-panel-text></p>
          <ul class="mt-3 flex list-none flex-wrap gap-1.5 p-0" data-panel-tech></ul>
        </div>
        <div data-panel-path hidden>
          <div class="flex items-center justify-between gap-3">
            <h2 class="m-0 font-display text-[26px] leading-none text-yellow" data-panel-path-title></h2>
            <button type="button" class="hl-btn" data-replay>{t(lang, "hl.replay")}</button>
          </div>
          <ol class="mt-3 grid gap-2 pl-5 text-paper" data-panel-steps></ol>
        </div>
      </aside>
      <div class="box overflow-x-auto p-2 sm:p-3">
        <svg class="hl-map block h-auto w-full min-w-[820px]" viewBox={`0 0 ${VIEW.w} ${VIEW.h}`} role="group" aria-label={t(lang, "hl.map")} data-map>
          {frames.map((f) => (
            <g class={`hl-frame hl-frame-${f.id}`}>
              <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="10"></rect>
              <text x={f.x + 14} y={f.y + 24}>{f.label}</text>
            </g>
          ))}
          <g class="hl-links" aria-hidden="true">
            {links.map(([a, b]) => <path d={segment(a, b)} data-link={`${a}:${b}`}></path>)}
          </g>
          <g class="hl-segs" aria-hidden="true">
            {paths.map((p) => p.steps.map((s, i) => <path d={segment(s.from, s.to)} data-seg={`${p.id}:${i}`}></path>))}
          </g>
          {blocks.map((b) => {
            const r = box(b);
            return (
              <a href={`#b-${b.id}`} class={`hl-node zone-${b.zone}`} data-node={b.id} aria-label={b.label}>
                <rect x={r.x} y={r.y} width={r.w} height={r.h} rx="6"></rect>
                <text class="hl-label" x={r.x + r.w / 2} y={r.y + (b.tech ? 27 : 36)} text-anchor="middle">{b.label}</text>
                {b.tech && <text class="hl-tech" x={r.x + r.w / 2} y={r.y + 46} text-anchor="middle">{b.tech.join(" · ")}</text>}
              </a>
            );
          })}
          <circle class="hl-dot" r="8" cx="-20" cy="-20" data-dot aria-hidden="true"></circle>
        </svg>
      </div>
    </div>
  </Ground>

  <Ground kind="split" id="layers" label={t(lang, "hl.layers")}>
    <h2 class="title text-ink [text-shadow:4px_4px_0_var(--color-paper)]">{t(lang, "hl.layers")}</h2>
    <ol class="mt-8 grid list-none gap-4 p-0 md:grid-cols-2 xl:grid-cols-4">
      {layers.map((ly, i) => (
        <li class:list={["box grid content-start gap-2", { "bg-yellow": i % 2 === 1 }]}>
          <span class="label">{i + 1} · {l(ly.title, lang)}</span>
          <p class="m-0">{l(ly.text, lang)}</p>
          <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
            {ly.blocks.map((id) => <li class="chip">{get(id).label}</li>)}
          </ul>
          <button type="button" class="hl-btn mt-1 justify-self-start" data-layer={ly.blocks.join(" ")} data-js-only hidden>{t(lang, "hl.show")} ↑</button>
        </li>
      ))}
    </ol>
  </Ground>

  <Ground kind="moire" id="principles" label={t(lang, "hl.principles")}>
    <h2 class="title text-yellow [text-shadow:5px_5px_0_var(--color-ink)]">{t(lang, "hl.principles")}</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {principles.map((p, i) => (
        <section class:list={["box grid content-start gap-1", { "box-ink": i === 3 }]}>
          <h3 class:list={["label m-0", i === 3 ? "text-pink" : "text-magenta"]}>{l(p.title, lang)}</h3>
          <p class:list={["m-0", { "text-paper": i === 3 }]}>{l(p.text, lang)}</p>
        </section>
      ))}
    </div>
    <p class="label mt-6 mb-0 flex flex-wrap gap-2">
      <span class="inline-block bg-ink px-3 py-2 text-yellow">{t(lang, "hl.repos")}</span>
      <a class="inline-block bg-paper px-3 py-2 no-underline shadow-print-sm hover:bg-yellow" href={profile.links.homelabNix}>github.com/Orysse/homelab-nix ↗</a>
      <a class="inline-block bg-paper px-3 py-2 no-underline shadow-print-sm hover:bg-yellow" href={profile.links.homelabCluster}>github.com/Orysse/homelab-cluster ↗</a>
    </p>
  </Ground>

  <Ground kind="liquid" id="text" label={t(lang, "hl.text")}>
    <h2 class="title text-paper [text-shadow:5px_5px_0_var(--color-ink),-2px_-2px_0_var(--color-magenta)]">{t(lang, "hl.text")}</h2>
    <div class="mt-8 grid items-start gap-5 lg:grid-cols-2">
      {zones.map((z) => (
        <section class="box grid content-start gap-3">
          <h3 class="label m-0">{zoneOf(z)}</h3>
          <dl class="m-0 grid gap-3">
            {blocks.filter((b) => b.zone === z).map((b) => (
              <div id={`b-${b.id}`} class="hl-entry scroll-mt-24">
                <dt class="font-semibold">{b.label}{b.tech && <span class="ml-2 font-mono text-[12px] font-normal opacity-70">{b.tech.join(" · ")}</span>}</dt>
                <dd class="m-0 text-[15px]">{l(b.text, lang)}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
      <section class="box box-ink grid content-start gap-4 text-paper">
        <h3 class="label m-0 text-pink">{t(lang, "hl.paths")}</h3>
        {paths.map((p) => (
          <div>
            <h4 class="m-0 font-semibold text-yellow">{l(p.title, lang)}</h4>
            <ol class="m-0 mt-1 grid gap-1 pl-5 text-[15px]">
              {p.steps.map((s) => <li>{l(s.text, lang)}</li>)}
            </ol>
          </div>
        ))}
      </section>
    </div>
  </Ground>

  <script type="application/json" data-homelab-data set:html={JSON.stringify({
    blocks: Object.fromEntries(blocks.map((b) => [b.id, { label: b.label, zone: zoneOf(b.zone), tech: b.tech ?? [], text: l(b.text, lang) }])),
    paths: Object.fromEntries(paths.map((p) => [p.id, { title: l(p.title, lang), steps: p.steps.map((s) => ({ from: s.from, to: s.to, text: l(s.text, lang) })) }])),
  })} />

  <script>
    import { homelab } from "../scripts/homelab";
    const root = document.querySelector<HTMLElement>("[data-homelab]");
    if (root) homelab(root);
  </script>
</Layout>
