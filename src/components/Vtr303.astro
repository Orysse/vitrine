---
import { t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Front panel laid out like a TB-303: knob row on top, keys with LEDs at the bottom.
const knobRow = [
  { p: "tune", label: "Tune", min: -12, max: 12, step: 0.1, def: 0 },
  { p: "cutoff", label: "Cut off freq", min: 0, max: 1, step: 0.01, def: 0.35 },
  { p: "resonance", label: "Resonance", min: 0, max: 1, step: 0.01, def: 0.7 },
  { p: "envMod", label: "Env mod", min: 0, max: 1, step: 0.01, def: 0.6 },
  { p: "decay", label: "Decay", min: 0, max: 1, step: 0.01, def: 0.4 },
  { p: "accent", label: "Accent", min: 0, max: 1, step: 0.01, def: 0.6 },
];
const outRow = [
  { p: "drive", label: "Drive", min: 0, max: 1, step: 0.01, def: 0.3 },
  { p: "volume", label: "Volume", min: 0, max: 1, step: 0.01, def: 0.7 },
];
// One octave on a 16-column grid: whites take two columns, sharps sit on the boundaries.
const whites = [
  { n: 0, label: "C", col: "col-start-1" }, { n: 2, label: "D", col: "col-start-3" },
  { n: 4, label: "E", col: "col-start-5" }, { n: 5, label: "F", col: "col-start-7" },
  { n: 7, label: "G", col: "col-start-9" }, { n: 9, label: "A", col: "col-start-11" },
  { n: 11, label: "B", col: "col-start-13" }, { n: 12, label: "C", col: "col-start-15" },
];
const sharps = [
  { n: 1, label: "C♯", col: "col-start-2" }, { n: 3, label: "D♯", col: "col-start-4" },
  { n: 6, label: "F♯", col: "col-start-8" }, { n: 8, label: "G♯", col: "col-start-10" },
  { n: 10, label: "A♯", col: "col-start-12" },
];
const fns = [
  { f: "down", label: "Down", title: t(lang, "vtr.down") },
  { f: "up", label: "Up", title: t(lang, "vtr.up") },
  { f: "accent", label: "Accent", title: "accent" },
  { f: "slide", label: "Slide", title: "slide" },
  { f: "rest", label: "Rest", title: t(lang, "vtr.rest") },
];
const presets = ["squelch", "rolling", "minor", "stabs", "hypnotic"];
---

<div class="vtr303 grid gap-0 overflow-hidden rounded-[10px] text-[#111]" data-vtr>
  <!-- Upper panel: markings, waveform switch, knob row. -->
  <div class="p303-top grid gap-5 px-5 pt-4 pb-6 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <p class="m-0 font-sans text-[22px] font-extrabold tracking-[-.02em] italic">VTR</p>
      <div class="text-right leading-none">
        <p class="m-0 text-[10px] font-semibold tracking-[.18em] uppercase">Computer Controlled</p>
        <p class="m-0 mt-1 flex items-baseline justify-end gap-3">
          <span class="font-serif text-[30px] italic">Bass Line</span>
          <span class="font-sans text-[24px] font-extrabold tracking-[-.01em]">VTR-303</span>
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-end gap-x-6 gap-y-5" role="group" aria-label={t(lang, "vtr.voice")}>
      <div class="grid justify-items-center gap-1.5">
        <span class="p303-lbl">Waveform</span>
        <button type="button" class="p303-switch" aria-pressed="false" data-wave aria-label={`${t(lang, "vtr.saw")} / ${t(lang, "vtr.square")}`}><span></span></button>
        <span class="flex w-[64px] justify-between font-mono text-[9px]"><span>SAW</span><span>SQR</span></span>
      </div>
      {knobRow.map((k) => (
        <div class="grid justify-items-center gap-1.5">
          <div class="knob" role="slider" tabindex="0" aria-label={k.label} aria-valuemin={k.min} aria-valuemax={k.max} aria-valuenow={k.def} data-knob={k.p} data-min={k.min} data-max={k.max} data-inc={k.step} data-default={k.def}></div>
          <span class="p303-lbl">{k.label}</span>
          <output class="font-mono text-[10px] opacity-70" data-for={k.p}></output>
        </div>
      ))}
      <div class="ml-auto flex items-end gap-6">
        {outRow.map((k) => (
          <div class="grid justify-items-center gap-1.5">
            <div class="knob knob-sm" role="slider" tabindex="0" aria-label={k.label} aria-valuemin={k.min} aria-valuemax={k.max} aria-valuenow={k.def} data-knob={k.p} data-min={k.min} data-max={k.max} data-inc={k.step} data-default={k.def}></div>
            <span class="p303-lbl">{k.label}</span>
            <output class="font-mono text-[10px] opacity-70" data-for={k.p}></output>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Lower panel: tempo, run/stop, step LEDs, keys. -->
  <div class="p303-bottom grid gap-5 px-5 pt-5 pb-6 sm:px-8 lg:grid-cols-[auto_minmax(0,1fr)]">
    <div class="flex flex-wrap items-end gap-6 lg:flex-col lg:items-start">
      <div class="grid justify-items-center gap-1.5">
        <div class="knob knob-lg" role="slider" tabindex="0" aria-label="tempo" aria-valuemin="60" aria-valuemax="200" aria-valuenow="138" data-knob="bpm" data-min="60" data-max="200" data-inc="1" data-default="138"></div>
        <span class="p303-lbl">Tempo</span>
        <output class="font-mono text-[10px] opacity-70" data-for="bpm"></output>
      </div>
      <div class="grid justify-items-center gap-1.5">
        <div class="knob knob-sm" role="slider" tabindex="0" aria-label={t(lang, "vtr.length")} aria-valuemin="1" aria-valuemax="16" aria-valuenow="16" data-knob="length" data-min="1" data-max="16" data-inc="1" data-default="16"></div>
        <span class="p303-lbl">{t(lang, "vtr.length")}</span>
        <output class="font-mono text-[10px] opacity-70" data-for="length"></output>
      </div>
      <div class="key303">
        <span class="led"></span>
        <button type="button" class="cap cap-run" aria-pressed="false" data-transport data-umami-event="303-play" aria-label={`${t(lang, "vtr.play")} / ${t(lang, "vtr.stop")}`}></button>
        <span class="p303-lbl">Run / Stop</span>
      </div>
    </div>

    <div class="grid min-w-0 gap-5">
      <div class="-mx-1 overflow-x-auto px-1 pb-1">
        <div class="p303-display grid min-w-[700px] grid-cols-16 gap-1 p-2" role="group" aria-label={t(lang, "vtr.steps")}>
          {Array.from({ length: 16 }, (_, i) => (
            <div class="step303" data-step={i}>
              <button type="button" class="step303-btn" data-select aria-label={`${t(lang, "vtr.step")} ${i + 1}`}>
                <span class="led"></span>
                <span class="block font-mono text-[9px] opacity-60">{i + 1}</span>
                <span class="block font-mono text-[13px] font-medium" data-name>C</span>
                <span class="flex justify-center gap-[3px] font-mono text-[8.5px]">
                  <i data-ind="down">↓</i><i data-ind="up">↑</i><i data-ind="accent">A</i><i data-ind="slide">S</i>
                </span>
              </button>
            </div>
          ))}
        </div>
      </div>

      <div class="flex flex-wrap items-start gap-x-8 gap-y-5">
        <div class="grid min-w-[340px] flex-1 grid-cols-16 gap-x-1 gap-y-3" role="group" aria-label={t(lang, "vtr.keyboard")}>
          {sharps.map((k) => (
            <div class:list={["key303 col-span-2 row-start-1", k.col]}>
              <span class="led"></span>
              <button type="button" class="cap cap-sharp" data-key={k.n} aria-label={k.label} aria-pressed="false"></button>
              <span class="p303-lbl">{k.label}</span>
            </div>
          ))}
          {whites.map((k, i) => (
            <div class:list={["key303 col-span-2 row-start-2", k.col]}>
              <span class="led"></span>
              <button type="button" class="cap" data-key={k.n} aria-label={k.label + (i === 7 ? "′" : "")} aria-pressed="false"></button>
              <span class="p303-lbl">{k.label}</span>
            </div>
          ))}
        </div>
        <div class="grid grid-cols-5 gap-x-2 gap-y-3" role="group" aria-label={t(lang, "vtr.step")}>
          {fns.map((k) => (
            <div class="key303">
              <span class="led"></span>
              <button type="button" class="cap cap-fn" data-fn={k.f} aria-pressed="false" title={k.title} aria-label={k.title}></button>
              <span class="p303-lbl">{k.label}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 border-t border-[#111]/25 pt-4">
        <label class="p303-lbl flex items-center gap-2">
          Pattern
          <select class="p303-select" data-preset>
            <option value="">…</option>
            {presets.map((p) => <option value={p}>{p}</option>)}
          </select>
        </label>
        <button type="button" class="p303-small" data-random>{t(lang, "vtr.random")}</button>
        <button type="button" class="p303-small" data-clear>{t(lang, "vtr.clear")}</button>
        <button type="button" class="p303-small" data-share data-label-done={t(lang, "vtr.copied")}>{t(lang, "vtr.share")}</button>
        <span class="ml-auto flex items-center gap-2">
          <span class="p303-lbl">Rhythm</span>
          <button type="button" class="p303-small" aria-pressed="true" data-drum="kick">kick</button>
          <button type="button" class="p303-small" aria-pressed="false" data-drum="hat">hat</button>
        </span>
      </div>
    </div>
  </div>

  <div class="bg-[#0b1408] p-2">
    <canvas class="block h-[80px] w-full" data-scope aria-hidden="true"></canvas>
  </div>
  <p class="m-0 bg-[#111] px-4 py-2 text-[13px] font-semibold text-[#ff4a3a]" data-status hidden>{t(lang, "vtr.unsupported")}</p>
</div>
