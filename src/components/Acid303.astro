---
import { t, type Lang } from "../i18n";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="box box-ink grid gap-3" data-acid data-js-only hidden>
  <p class="label m-0 text-pink">{t(lang, "acid.title")}</p>
  <p class="m-0 text-[14px] text-paper">{t(lang, "acid.note")}</p>
  <canvas class="block h-[70px] w-full bg-[#0b1408]" data-scope aria-hidden="true"></canvas>
  <div class="flex flex-wrap items-center gap-3">
    <button type="button" aria-pressed="false" class="cursor-pointer bg-magenta px-3 py-2 font-mono text-[13px] font-medium text-white aria-pressed:bg-paper aria-pressed:text-ink" data-play data-label-play={t(lang, "acid.play")} data-label-stop={t(lang, "acid.stop")}>{t(lang, "acid.play")}</button>
    <label class="label flex min-w-[110px] flex-1 flex-col gap-1 text-[11px]">cutoff <input class="w-full accent-yellow" type="range" min="0" max="1" step="0.01" value="0.35" data-cut /></label>
    <label class="label flex min-w-[110px] flex-1 flex-col gap-1 text-[11px]">reso <input class="w-full accent-yellow" type="range" min="0" max="1" step="0.01" value="0.7" data-res /></label>
  </div>
</div>
