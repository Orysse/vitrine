---
interface Props {
  to: string;
  lang: string;
}
const { to, lang } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <link rel="canonical" href={to} />
    <title>Moved</title>
  </head>
  <body>
    <p>Moved to <a href={to}>{to}</a>.</p>
  </body>
</html>
