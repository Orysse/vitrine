---
import type { CollectionEntry } from "astro:content";
import Halftone from "./Halftone.astro";
import { homelabUrl, projectUrl, t, type Lang } from "../i18n";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Lang;
  slug: string;
}
const { project, lang, slug } = Astro.props;
const p = project.data;
---

<article class="flex flex-col bg-paper shadow-print odd:-rotate-1 even:rotate-1">
  <figure class="m-0 border-b-[3px] border-ink">
    <Halftone art={p.art} paper={p.paper} width={480} height={300} label={p.title} src={p.photo?.src} />
    {p.photo && (
      <figcaption class="bg-paper px-3 py-1 font-mono text-[10.5px] opacity-75">
        <a class="no-underline hover:underline" href={p.photo.url}>{p.photo.credit}, {p.photo.license}</a>
      </figcaption>
    )}
  </figure>
  <div class="flex flex-1 flex-col gap-3 p-4">
    <h3 class="m-0 font-display text-[30px] leading-none">{p.title}</h3>
    <p class="m-0">{p.summary}</p>
    <dl class="m-0 grid grid-cols-[max-content_minmax(0,1fr)] gap-x-3 gap-y-1 text-[14px]">
      {p.facts.slice(0, 4).map(([k, v]) => (
        <>
          <dt class="label pt-0.5 text-[11px]">{k}</dt>
          <dd class="m-0">{v}</dd>
        </>
      ))}
    </dl>
    <p class="label mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-2">
      <a class="border-b-[3px] border-magenta no-underline hover:bg-yellow" href={projectUrl(lang, slug)} data-umami-event="project-details" data-umami-event-project={slug}>{t(lang, "project.more")} →</a>
      {p.map && <a class="border-b-[3px] border-magenta no-underline hover:bg-yellow" href={homelabUrl(lang)} data-umami-event="homelab-map" data-umami-event-from="card">{t(lang, "hl.open")} →</a>}
      {p.repo && <a class="border-b-[3px] border-ink no-underline hover:bg-yellow" href={p.repo} data-umami-event="repo" data-umami-event-project={slug}>{t(lang, "project.repo")} ↗</a>}
    </p>
  </div>
</article>
