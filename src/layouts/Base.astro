---
import "@fontsource/hanken-grotesk/latin-400.css";
import "@fontsource/hanken-grotesk/latin-800.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "../styles/tokens.css";
import "../styles/page.css";
import { langs, path, t, type Lang } from "../i18n";
import { profile } from "../profile";

interface Props {
  lang: Lang;
  title: string;
  description: string;
}
const { lang, title, description } = Astro.props;
const other: Lang = lang === "fr" ? "en" : "fr";
const site = Astro.site ?? new URL("https://vitrine.abe.lc");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(path(lang), site)} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(path(l), site)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, "nav.skip")}</a>
    <header class="bar wrap">
      <a
        href={path(other)}
        hreflang={other}
        lang={other}
        aria-label={t(lang, "lang.switch.label")}>{t(lang, "lang.switch")}</a
      >
      <a class="cv" href={profile.cv[lang]}>{t(lang, "bar.cv")}</a>
    </header>
    <slot />
    <script>
      import "../scripts/hash-open.ts";
    </script>
  </body>
</html>
