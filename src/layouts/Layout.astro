---
import "../styles/global.css";
import { home, t, type Lang } from "../i18n";
import { profile } from "../profile";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** URL of this page in each language, for the switcher and hreflang. */
  alternates: Record<Lang, string>;
  /** Show the in-page CV section links (home only). */
  sections?: boolean;
}

const { lang, title, description, alternates, sections = false } = Astro.props;
const other: Lang = lang === "fr" ? "en" : "fr";
const canonical = new URL(alternates[lang], Astro.site);
const anchor = (id: string) => (sections ? `#${id}` : `${home(lang)}#${id}`);
const nav = [
  ["experience", t(lang, "nav.experience")],
  ["projects", t(lang, "nav.projects")],
  ["education", t(lang, "nav.education")],
  ["skills", t(lang, "nav.skills")],
  ["interests", t(lang, "nav.interests")],
] as const;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#1a0b2e" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL(alternates.fr, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a href="#main" class="absolute -left-[999px] top-2 z-50 bg-yellow px-3 py-2 font-semibold focus:left-2">{t(lang, "skip")}</a>

    <header class="sticky top-0 z-40 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b-[3px] border-magenta bg-ink px-4 py-2.5 text-paper sm:px-8">
      <a href={home(lang)} class="font-display text-[26px] leading-none text-yellow no-underline">{profile.name}</a>
      <nav aria-label="Sections" class="flex flex-wrap gap-x-5 gap-y-1 text-[13px] font-bold tracking-[.08em] uppercase">
        {nav.map(([id, label]) => <a class="border-b-2 border-transparent py-1 no-underline hover:border-yellow hover:text-yellow" href={anchor(id)}>{label}</a>)}
        <a class="border-b-2 border-transparent py-1 no-underline hover:border-yellow hover:text-yellow" href={profile.cv[lang]}>{t(lang, "nav.cv")}</a>
        <a class="py-1 text-pink no-underline hover:text-yellow" href={alternates[other]} hreflang={other} lang={other}>{t(lang, "nav.lang")}</a>
      </nav>
      <div class="label flex items-center gap-3 text-paper" data-js-only hidden>
        <label class="flex items-center gap-2">{t(lang, "knob.trip")} <input id="trip" class="w-28 accent-pink" type="range" min="0" max="1" step="0.01" value="0.6" /></label>
        <button id="motion" type="button" aria-pressed="true" class="cursor-pointer border border-paper px-2.5 py-1 hover:bg-paper hover:text-ink" data-label-pause={t(lang, "knob.pause")} data-label-play={t(lang, "knob.play")}>{t(lang, "knob.pause")}</button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <svg class="absolute h-0 w-0" aria-hidden="true" focusable="false">
      <filter id="warp" x="-5%" y="-15%" width="110%" height="140%">
        <feTurbulence id="warpT" type="turbulence" baseFrequency="0.006 0.022" numOctaves="2" seed="2" result="n" />
        <feDisplacementMap id="warpD" in="SourceGraphic" in2="n" scale="18" xChannelSelector="R" yChannelSelector="B" />
      </filter>
    </svg>

    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
