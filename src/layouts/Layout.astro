---
import "../styles/global.css";
import { home, poles, synthUrl, colophonUrl, t, type Lang } from "../i18n";
import { profile } from "../profile";
import { umami } from "../analytics";
import { build } from "../build";

type PoleKey = "index" | "systems" | "resume" | "colophon" | "none";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  alternates: Record<Lang, string>;
  pole?: PoleKey;
}

const { lang, title, description, alternates, pole = "none" } = Astro.props;
const other: Lang = lang === "fr" ? "en" : "fr";
const canonical = new URL(alternates[lang], Astro.site);
const navPoles = poles(lang);
const cvHref = profile.cv[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f3ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121110" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL(alternates.fr, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/theme.js"></script>
    {umami.websiteId && <script is:inline defer src={`${umami.host}/script.js`} data-website-id={umami.websiteId} data-domains={umami.domains}></script>}
  </head>
  <body>
    <a class="skip no-print" href="#main">{t(lang, "skip")}</a>

    <header class="bar no-print">
      <a class="label label-ink" href={home(lang)}>{profile.name}</a>
      <span class="label">{t(lang, "chassis.status")}</span>
      <nav class="bar-nav" aria-label={lang === "fr" ? "Pages" : "Pages"}>
        {navPoles.map((item) => (
          <a href={item.href} aria-current={pole === item.key ? "page" : undefined}>{item.label}</a>
        ))}
        <a href={alternates[other]} hreflang={other} data-locale-switch>{other.toUpperCase()}</a>
        <button type="button" class="big-link no-print" data-polarity-toggle aria-pressed="false" title={t(lang, "chassis.inv.title")}>{t(lang, "chassis.inv")}</button>
        <a class="big-link" href={cvHref}>{t(lang, "chassis.cv")}</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="bar bar-foot no-print">
      <span class="label">vitrine {build.version}</span>
      <span class="label">{build.revUrl ? <a href={build.revUrl}>{build.rev}</a> : build.rev}</span>
      {build.date && (
        <span class="label">{t(lang, "colophon.built")} <time datetime={build.date}>{build.date}</time></span>
      )}
      <nav class="bar-nav" aria-label={lang === "fr" ? "Pied de page" : "Footer"}>
        <a href={colophonUrl(lang)}>{t(lang, "nav.colophon")}</a>
        <a href={synthUrl(lang)}>{t(lang, "vtr.nav")}</a>
        <a href={profile.links.source}>{t(lang, "colophon.source")}</a>
      </nav>
    </footer>

    <script>
      import "../scripts/ui";
    </script>
  </body>
</html>