---
import "../styles/global.css";
import { home, projectUrl, synthUrl, t, type Lang } from "../i18n";
import { profile } from "../profile";
import { umami } from "../analytics";
import { build } from "../build";

// Each page is its own universe (palette, ground, type); the trail at the top stays in place
// from one to the next (view transitions) and marks the current and the visited pages.
export type Universe = "home" | "homelab" | "config" | "synth";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** URL of this page in each language, for the switcher and hreflang. */
  alternates: Record<Lang, string>;
  universe: Universe;
  /** Wider column, for the project pages and the 303 panel. */
  wide?: boolean;
}

const { lang, title, description, alternates, universe, wide = false } = Astro.props;
const other: Lang = lang === "fr" ? "en" : "fr";
const canonical = new URL(alternates[lang], Astro.site);
const stations: { key: Universe; href: string; label: string }[] = [
  { key: "home", href: home(lang), label: profile.name.split(" ")[0] },
  { key: "homelab", href: projectUrl(lang, "homelab"), label: "Homelab" },
  { key: "config", href: projectUrl(lang, "config"), label: t(lang, "trail.config") },
  { key: "synth", href: synthUrl(lang), label: "303" },
];
// Background colour of each universe, for the browser chrome.
const themeColor: Record<Universe, string | undefined> = { home: undefined, homelab: "#0c1724", config: "#2d353b", synth: "#e4e3dd" };
---

<!doctype html>
<html lang={lang} data-universe={universe}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {themeColor[universe] ? (
      <meta name="theme-color" content={themeColor[universe]} />
    ) : (
      <>
        <meta name="theme-color" content="#f7f3ec" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#171511" media="(prefers-color-scheme: dark)" />
      </>
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL(alternates.fr, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {umami.websiteId && <script is:inline defer src={`${umami.host}/script.js`} data-website-id={umami.websiteId} data-domains={umami.domains}></script>}
  </head>
  <body>
    <a href="#main" class="skip">{t(lang, "skip")}</a>

    <header class="trail-bar no-print">
      <nav class="trail" aria-label={t(lang, "trail.label")}>
        <ol>
          {stations.map((s) => (
            <li>
              <a class="station" href={s.href} aria-current={s.key === universe ? "page" : undefined}>
                <span class="stop"></span><span class="station-label">{s.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <a class="lang" href={alternates[other]} hreflang={other} lang={other} aria-label={t(lang, "nav.langName")}>{t(lang, "nav.lang")}</a>
    </header>

    <main id="main" class:list={["mx-auto px-4 sm:px-6", wide ? "max-w-[68rem]" : "max-w-[44rem]"]}>
      <slot />
    </main>

    <footer class="colophon no-print">
      <p>
        vitrine <a href={build.tagUrl}>{build.version}</a>
        {build.revUrl ? <> · <a href={build.revUrl}>{build.rev}</a></> : <> · {build.rev}</>}
        {build.date && <> · {t(lang, "colophon.built")} <time datetime={build.date}>{build.date}</time></>}
        · <a href={profile.links.source}>{t(lang, "colophon.source")}</a>
      </p>
      <p>{t(lang, "colophon.stack")}</p>
    </footer>
  </body>
</html>
