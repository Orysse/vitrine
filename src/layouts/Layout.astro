---
import "../styles/global.css";
import { home, synthUrl, t, type Lang } from "../i18n";
import { profile } from "../profile";
import { umami } from "../analytics";
import { build } from "../build";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** URL of this page in each language, for the switcher and hreflang. */
  alternates: Record<Lang, string>;
  /** Wider column, for the 303 panel. */
  wide?: boolean;
}

const { lang, title, description, alternates, wide = false } = Astro.props;
const other: Lang = lang === "fr" ? "en" : "fr";
const canonical = new URL(alternates[lang], Astro.site);
const isHome = alternates[lang] === home(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151514" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL(alternates.fr, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {umami.websiteId && <script is:inline defer src={`${umami.host}/script.js`} data-website-id={umami.websiteId} data-domains={umami.domains}></script>}
  </head>
  <body>
    <a href="#main" class="absolute -left-[999px] top-2 z-50 rounded-md bg-fg px-3 py-2 text-bg focus:left-2">{t(lang, "skip")}</a>

    <div class:list={["mx-auto px-4 sm:px-6", wide ? "max-w-[64rem]" : "max-w-[42rem]"]}>
      <header class="no-print flex items-baseline justify-between gap-4 pt-8 pb-14 text-[14px] sm:pt-12">
        {isHome ? <span class="text-muted">vitrine.abe.lc</span> : <a class="font-medium no-underline hover:underline" href={home(lang)}>{profile.name}</a>}
        <a class="text-muted no-underline hover:text-fg hover:underline" href={alternates[other]} hreflang={other} lang={other}>{t(lang, "nav.lang")}</a>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="no-print mt-24 border-t border-line pt-6 pb-12 font-mono text-[12.5px] leading-6 text-muted">
        <p class="m-0">
          vitrine <a href={build.tagUrl}>{build.version}</a>
          {build.revUrl ? <> · <a href={build.revUrl}>{build.rev}</a></> : <> · {build.rev}</>}
          {build.date && <> · {t(lang, "colophon.built")} <time datetime={build.date}>{build.date}</time></>}
        </p>
        <p class="m-0">{t(lang, "colophon.stack")}</p>
        <p class="m-0">
          <a href={profile.links.source}>{t(lang, "colophon.source")}</a> · <a href={synthUrl(lang)}>{t(lang, "vtr.nav")}</a>
        </p>
      </footer>
    </div>
  </body>
</html>
