---
import "../styles/global.css";
import { home, navItems, synthUrl, t, type Lang } from "../i18n";
import { profile } from "../profile";
import { umami } from "../analytics";
import { build } from "../build";

type ActiveTab = "index" | "homelab" | "config" | "vitrine" | "systems" | "resume" | "colophon" | "none";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  alternates: Record<Lang, string>;
  pole?: ActiveTab;
}

const { lang, title, description, alternates, pole = "none" } = Astro.props;
const other: Lang = lang === "fr" ? "en" : "fr";
const canonical = new URL(alternates[lang], Astro.site);
const items = navItems(lang);
const cvHref = profile.cv[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0c0c" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL(alternates.fr, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/theme.js"></script>
    {umami.websiteId && <script is:inline defer src={`${umami.host}/script.js`} data-website-id={umami.websiteId} data-domains={umami.domains}></script>}
  </head>
  <body>
    <a class="skip no-print" href="#main">{t(lang, "skip")}</a>

    <header class="site-header no-print">
      <div class="site-header-inner">
        <a class="site-brand" href={home(lang)}>{profile.name}</a>

        <nav class="site-tabs" aria-label={lang === "fr" ? "Navigation principale" : "Main navigation"}>
          {items.map((item) => (
            <a
              class="site-tab"
              href={item.href}
              aria-current={pole === item.key ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="site-utils">
          <a class="util-link" href={alternates[other]} hreflang={other} data-locale-switch>
            {other.toUpperCase()}
          </a>
          <button
            type="button"
            class="util-link"
            data-polarity-toggle
            aria-pressed="false"
            title={t(lang, "chassis.inv.title")}
          >
            {t(lang, "chassis.inv")}
          </button>
          <a class="util-pill" href={cvHref}>{t(lang, "chassis.cv")}</a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer no-print">
      <div class="site-footer-inner">
        <span>
          vitrine {build.version} · {build.revUrl ? <a href={build.revUrl}>{build.rev}</a> : build.rev}
          {build.date && (
            <>
              {" "}· <time datetime={build.date}>{build.date}</time>
            </>
          )}
        </span>
        <span>
          <a href={profile.links.source} rel="noopener">{t(lang, "colophon.source")}</a>
          {" · "}
          <a href={synthUrl(lang)}>{t(lang, "vtr.nav")}</a>
        </span>
      </div>
    </footer>

    <script>
      import "../scripts/ui";
    </script>
  </body>
</html>
