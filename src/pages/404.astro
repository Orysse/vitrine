---
import Layout from "../layouts/Layout.astro";
import { t } from "../i18n";
---

<Layout lang="fr" title="404 · Abel Chartier" description={t("fr", "notfound")} alternates={{ fr: "/", en: "/en/" }}>
  <h1 class="m-0 font-mono text-[26px] font-medium">404</h1>
  <p class="mt-3 mb-0">{t("fr", "notfound")} <span class="text-muted" lang="en">{t("en", "notfound")}</span></p>
  <p class="mt-6 mb-0"><a href="/">Abel Chartier</a></p>
</Layout>
