---
import { getCollection } from "astro:content";
import ProjectPage from "../../../components/ProjectPage.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", (p) => p.id.startsWith("en/") && !p.data.page);
  return projects.map((project) => ({ params: { slug: project.id.split("/")[1] }, props: { project } }));
}
const { project } = Astro.props;
---

<ProjectPage project={project} lang="en" slug={Astro.params.slug} />
