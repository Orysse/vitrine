---
import { getCollection } from "astro:content";
import SystemDetailPage from "../../../views/SystemDetailPage.astro";

export async function getStaticPaths() {
  const projects = (
    await getCollection("projects", (entry) => entry.id.startsWith("en/"))
  ).sort((a, b) => a.data.order - b.data.order);

  return projects.map((project, index) => ({
    params: { slug: project.id.split("/")[1] },
    props: {
      project,
      prev: projects[index - 1]
        ? { slug: projects[index - 1].id.split("/")[1], title: projects[index - 1].data.title }
        : undefined,
      next: projects[index + 1]
        ? { slug: projects[index + 1].id.split("/")[1], title: projects[index + 1].data.title }
        : undefined,
    },
  }));
}

const { project, prev, next } = Astro.props;
---

<SystemDetailPage project={project} lang="en" slug={String(Astro.params.slug)} prev={prev} next={next} />
