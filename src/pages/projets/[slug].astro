---
import { getCollection } from "astro:content";
import Redirect from "../../components/Redirect.astro";
import { systemsUrl } from "../../i18n";

export async function getStaticPaths() {
  const projects = await getCollection("projects", (entry) => entry.id.startsWith("fr/"));
  return projects.map((project) => ({ params: { slug: project.id.split("/")[1] } }));
}

const to = systemsUrl("fr", String(Astro.params.slug));
---

<Redirect to={to} lang="fr" />
