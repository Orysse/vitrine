---
import { layers } from "../homelab";
import { l, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Exploded isometric stack, computed at build time: plain SVG, no script. A plate is a
// W × D slab of thickness T; plates are G apart. iso() projects (x, y, z) to the page.
const W = 150;
const D = 150;
const T = 8;
const G = 54;
const c = Math.cos(Math.PI / 6);
const s = 0.5;
const iso = (x: number, y: number, z: number) => [(x - y) * c, (x + y) * s - z];
const pts = (...corners: [number, number, number][]) =>
  corners.map(([x, y, z]) => iso(x, y, z).map((v) => v.toFixed(2)).join(",")).join(" ");

// Bottom plate first, so upper plates are drawn over lower ones.
const plates = layers
  .map((layer, i) => ({ layer, index: i + 1 }))
  .reverse()
  .map(({ layer, index }, k) => {
    const z0 = k * G;
    const z1 = z0 + T;
    return {
      index,
      motif: layer.motif,
      top: pts([0, 0, z1], [W, 0, z1], [W, D, z1], [0, D, z1]),
      left: pts([0, D, z1], [W, D, z1], [W, D, z0], [0, D, z0]),
      right: pts([W, 0, z1], [W, D, z1], [W, D, z0], [W, 0, z0]),
      // Maps the plate's own (x, y) onto its top face.
      onTop: `matrix(${c.toFixed(4)} ${s} ${(-c).toFixed(4)} ${s} 0 ${-z1})`,
    };
  });

const pad = 14;
const minX = -D * c - pad;
const minY = -((layers.length - 1) * G + T) - pad - 10;
const viewBox = `${minX.toFixed(1)} ${minY.toFixed(1)} ${(2 * -minX).toFixed(1)} ${((W + D) * s - minY + pad).toFixed(1)}`;
const grid = [30, 60, 90, 120];
---

<figure class="stack m-0 grid items-center gap-6 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] sm:gap-8">
  <svg viewBox={viewBox} class="mx-auto block w-full max-w-[14rem] overflow-visible" aria-hidden="true" focusable="false">
    {plates.map((p) => (
      <g class="plate" data-layer={p.index} stroke-width="1" stroke-linejoin="round">
        <polygon class="side" points={p.left} />
        <polygon class="side" points={p.right} />
        <polygon class="top" points={p.top} />
        <g transform={p.onTop} class="motif" stroke-width="1" vector-effect="non-scaling-stroke">
          {p.motif === "grid" && grid.map((v) => (
            <>
              <line x1={v} y1="12" x2={v} y2={D - 12} opacity=".45" vector-effect="non-scaling-stroke" />
              <line x1="12" y1={v} x2={W - 12} y2={v} opacity=".45" vector-effect="non-scaling-stroke" />
            </>
          ))}
          {p.motif === "vms" && [14, 58, 102].map((x) => (
            <rect x={x} y="22" width="34" height="106" rx="3" stroke-dasharray="4 3" vector-effect="non-scaling-stroke" />
          ))}
          {p.motif === "nodes" && (
            <>
              <path d="M40 45 L110 45 L75 108 Z" vector-effect="non-scaling-stroke" />
              {[[40, 45], [110, 45], [75, 108]].map(([x, y]) => <circle class="dot" cx={x} cy={y} r="8" />)}
            </>
          )}
          {p.motif === "tiles" && [30, 82].map((x) => (
            <rect x={x} y="40" width="38" height="70" rx="3" vector-effect="non-scaling-stroke" />
          ))}
          {p.motif === "ports" && (
            <>
              {[18, 40, 62, 84].map((x) => <rect class="dot" x={x} y={D - 22} width="14" height="7" rx="1" />)}
              <circle cx={W - 24} cy={D - 18} r="5" vector-effect="non-scaling-stroke" />
            </>
          )}
        </g>
      </g>
    ))}
  </svg>
  <ol class="legend m-0 grid list-none gap-0.5 p-0">
    {layers.map((layer) => (
      <li class="grid gap-x-4 sm:grid-cols-[6rem_minmax(0,1fr)]">
        <span class="font-medium">{l(layer.name, lang)}</span>
        <span class="meta">{l(layer.fact, lang)}</span>
      </li>
    ))}
  </ol>
</figure>
